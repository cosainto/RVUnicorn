    });

    if (!user) {
      return res.status(404).json({ error: 'User not found' });
    }

    // Get recipes created by user
    const recipes = await prisma.recipe.findMany({
      where: { authorId: user.id },
      take: limit,
      orderBy: { createdAt: 'desc' },
      include: {
        author: {
          select: {
            id: true,
            username: true,
            firstName: true,
            lastName: true,
            profilePicture: true,
          },
        },
