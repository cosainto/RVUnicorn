// Campground Events
model CampgroundEvent {
  id           String     @id @default(cuid())
  campgroundId String
  createdById  String
  title        String
  description  String?
  imageUrl     String?
  startDate    DateTime
  endDate      DateTime?
  location     String?    // Specific location within campground
  isRecurring  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  campground   Campground @relation(fields: [campgroundId], references: [id], onDelete: Casca// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  username        String    @unique
  firstName       String
  lastName        String
  profilePicture  String?
  coverPhoto      String?
  bio             String?
  location        String?
  website         String?
  facebookUrl     String?
  instagramUrl    String?
  tiktokUrl       String?
  redditUrl       String?
  youtubeUrl      String?
  twitterUrl      String?
  blueskyUrl      String?
  rvType          String?
  rvYear          Int?
  rvMake          String?
  rvModel         String?
  status          String?
  statusEmoji     String?
  statusType      String?
  currentCampsite String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  posts                Post[]
  comments             Comment[]
  likes                Like[]
  trips                Trip[]
  stays                Stay[]
  events               Event[]
  eventAttendees       EventAttendee[]
  gearItems            GearItem[]
  stateVisits          StateVisit[]
  stateVisitAttendees  StateVisitAttendee[]
  notifications        Notification[]
  friendshipsInitiated Friendship[] @relation("FriendshipInitiator")
  friendshipsReceived  Friendship[] @relation("FriendshipReceiver")
  recipes              Recipe[]
  recipeRatings        RecipeRating[]
  recipeComments       RecipeComment[]
  savedRecipes         SavedRecipe[]
  photoAlbums          PhotoAlbum[]
  photos               Photo[]
  checkIns             CheckIn[]
  userStickers         UserSticker[]
  stickerRequests      StickerRequest[]
  campgroundFollows    CampgroundFollow[]  
  campgroundAdmins       CampgroundAdmin[]
  campgroundPosts        CampgroundPost[]
  campgroundPostLikes    CampgroundPostLike[]
  campgroundPostComments CampgroundPostComment[]  



  @@index([email])
  @@index([username])
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@index([userId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Friendship {
  id          String   @id @default(cuid())
  initiatorId String
  receiverId  String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  initiator User @relation("FriendshipInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, receiverId])
  @@index([initiatorId])
  @@index([receiverId])
  @@index([status])
}

model Trip {
  id          String    @id @default(cuid())
  userId      String
  name        String
  startDate   DateTime
  endDate     DateTime
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stays Stay[]

  @@index([userId])
  @@index([startDate])
}

model Campground {
  id          String   @id @default(cuid())
  name        String
  location    String
  state       String?
  description String?
  latitude    Float?
  longitude   Float?
  amenities   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stays       Stay[]
  events      Event[]
  stateVisits StateVisit[]
  checkIns    CheckIn[]
  stickers    Sticker[]
  followers   CampgroundFollow[]  
  admins CampgroundAdmin[]
  posts  CampgroundPost[]


  @@index([state])
  @@index([name])
}

model Stay {
  id           String    @id @default(cuid())
  userId       String
  tripId       String?
  campgroundId String
  startDate    DateTime
  endDate      DateTime
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip       Trip?      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  campground Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
  @@index([campgroundId])
  @@index([startDate])
}

model Event {
  id           String    @id @default(cuid())
  organizerId  String
  campgroundId String?
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime
  location     String?
  isWishlist  Boolean  @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizer   User            @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  campground  Campground?     @relation(fields: [campgroundId], references: [id], onDelete: SetNull)
  attendees   EventAttendee[]
  meals       EventMeal[]
  stateVisits StateVisit[]

  @@index([organizerId])
  @@index([campgroundId])
  @@index([startDate])
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventMeal {
  id          String   @id @default(cuid())
  eventId     String
  recipeId    String?
  mealType    String
  scheduledAt DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([recipeId])
}

model GearItem {
  id          String   @id @default(cuid())
  userId      String
  name        String
  category    String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

model PhotoAlbum {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      Photo[]
  stateVisits StateVisitAlbum[]

  @@index([userId])
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  albumId   String?
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  album PhotoAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([albumId])
}

model StateVisit {
  id         String    @id @default(cuid())
  userId     String
  state      String
  startDate  DateTime
  endDate    DateTime?
  notes      String?
  campsiteId String?
  eventId    String?
  visibility String   @default("PUBLIC")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  campsite  Campground?          @relation(fields: [campsiteId], references: [id])
  event     Event?               @relation(fields: [eventId], references: [id])
  attendees StateVisitAttendee[]
  albums    StateVisitAlbum[]

  @@index([userId])
  @@index([state])
  @@index([startDate])
  @@index([campsiteId])
  @@index([eventId])
}

model StateVisitAlbum {
  id           String   @id @default(cuid())
  stateVisitId String
  albumId      String
  createdAt    DateTime @default(now())

  stateVisit StateVisit @relation(fields: [stateVisitId], references: [id], onDelete: Cascade)
  album      PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([stateVisitId, albumId])
  @@index([stateVisitId])
  @@index([albumId])
}

model StateVisitAttendee {
  id           String   @id @default(cuid())
  stateVisitId String
  attendeeId   String
  createdAt    DateTime @default(now())

  stateVisit StateVisit @relation(fields: [stateVisitId], references: [id], onDelete: Cascade)
  attendee   User       @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([stateVisitId, attendeeId])
  @@index([stateVisitId])
  @@index([attendeeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  content   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Recipe {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  ingredients  String[]
  instructions String[]
  prepTime     Int?
  cookTime     Int?
  servings     Int?
  difficulty   String?
  cuisine      String?
  category     String?
  privacy      String   @default("PUBLIC")
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings  RecipeRating[]
  meals    EventMeal[]
  comments RecipeComment[]
  savedBy  SavedRecipe[]

  @@index([userId])
  @@index([category])
  @@index([cuisine])
  @@index([privacy])
}

model RecipeRating {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  rating    Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
}

model RecipeComment {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([userId])
}

model SavedRecipe {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
}

model CheckIn {
  id           String    @id @default(cuid())
  userId       String
  campgroundId String
  checkInDate  DateTime
  checkOutDate DateTime?
  siteNumber   String?
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campground Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([campgroundId])
  @@index([isActive])
}

model Sticker {
  id           String   @id @default(cuid())
  campgroundId String
  name         String
  description  String?
  imageUrl     String?
  emoji        String?
  criteria     String?
  isLimited    Boolean  @default(false)
  maxQuantity  Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campground      Campground       @relation(fields: [campgroundId], references: [id], onDelete: Cascade)
  userStickers    UserSticker[]
  stickerRequests StickerRequest[]

  @@index([campgroundId])
}

model UserSticker {
  id        String   @id @default(cuid())
  userId    String
  stickerId String
  earnedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sticker Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)

  @@unique([userId, stickerId])
  @@index([userId])
  @@index([stickerId])
}

model StickerRequest {
  id        String   @id @default(cuid())
  userId    String
  stickerId String
  evidence  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sticker Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stickerId])
  @@index([status])
}

model CampgroundFollow {
  id           String   @id @default(cuid())
  userId       String
  campgroundId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campground Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)

  @@unique([userId, campgroundId])
  @@index([userId])
  @@index([campgroundId])
}
model CampgroundAdmin {
  id           String   @id @default(cuid())
  userId       String
  campgroundId String
  role         String   @default("admin")
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campground Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)

  @@unique([userId, campgroundId])
  @@index([userId])
  @@index([campgroundId])
}

model CampgroundPost {
  id           String   @id @default(cuid())
  campgroundId String
  authorId     String
  title        String?
  content      String
  imageUrl     String?
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campground Campground              @relation(fields: [campgroundId], references: [id], onDelete: Cascade)
  author     User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes      CampgroundPostLike[]
  comments   CampgroundPostComment[]

  @@index([campgroundId])
  @@index([authorId])
  @@index([createdAt])
}

model CampgroundPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post CampgroundPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model CampgroundPostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post CampgroundPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}
