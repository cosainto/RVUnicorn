model SavedTrip {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Trip details
  name            String
  description     String?
  
  // Route info
  originAddress   String
  originLat       Float
  originLng       Float
  destinationAddress String
  destinationLat  Float
  destinationLng  Float
  
  // Optional campground destination
  campgroundId    String?
  campground      Campground? @relation(fields: [campgroundId], references: [id])
  
  // Route data
  distanceMeters  Int
  durationSeconds Int
  polyline        String   @db.Text  // Encoded route polyline
  
  // Planned stops (JSON array of stop IDs and types)
  plannedStops    Json     @default("[]")
  
  // Fuel estimates
  estimatedFuelGallons Float?
  estimatedFuelCost    Float?
  mpgUsed              Float?
  
  // Trip dates (optional - for planned trips)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  
  // Link to an event/trip
  eventId         String?
  event           Event?   @relation(fields: [eventId], references: [id])
  
  // Visibility
  visibility      String   @default("PRIVATE") // PRIVATE, FRIENDS, PUBLIC
  
  // Stats
  viewCount       Int      @default(0)
  copyCount       Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Comments from other users
  comments        SavedTripComment[]
  
  @@index([userId])
  @@index([campgroundId])
  @@index([visibility])
}

