  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startDate])
  @@index([type])
}

model MomentPhoto {
  id        String      @id @default(cuid())
  momentId  String
  photoId   String
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  moment    PhotoMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  photo     Photo       @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([momentId, photoId])
  @@index([momentId])
  @@index([photoId])
}

model VideoWatch {
  id             String   @id @default(cuid())
  videoId        String
  userId         String?
  sessionId      String
  watchedSeconds Int      @default(0)
  totalDuration  Int
  completionRate Float    @default(0)
  dropOffSecond  Int?
  rewatchCount   Int      @default(0)
  source         String   @default("FEED")
  deviceType     String?
  isFollower     Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([userId])
  @@index([createdAt])
  @@index([source])
  @@index([completionRate])
}

model ContentAnalytics {
  id               String   @id @default(cuid())
  contentId        String
  contentType      String
  userId           String
  date             DateTime @db.Date
  views            Int      @default(0)
  uniqueViews      Int      @default(0)
  likes            Int      @default(0)
  comments         Int      @default(0)
  saves            Int      @default(0)
  shares           Int      @default(0)
  totalWatchTime   Int      @default(0)
  avgWatchTime     Float    @default(0)
  avgCompletion    Float    @default(0)
  feedViews        Int      @default(0)
  profileViews     Int      @default(0)
  directViews      Int      @default(0)
  shareViews       Int      @default(0)
  discoveryViews   Int      @default(0)
  followerViews    Int      @default(0)
  nonFollowerViews Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contentId, date])
  @@index([userId])
  @@index([contentType])
  @@index([date])
}

model ProfileVisit {
  id               String   @id @default(cuid())
  profileUserId    String
  visitorId        String?
  source           String   @default("DIRECT")
  sourceContentId  String?
  resultedInFollow Boolean  @default(false)
  createdAt        DateTime @default(now())
  profileUser      User     @relation("ProfileVisits", fields: [profileUserId], references: [id], onDelete: Cascade)
  visitor          User?    @relation("VisitorVisits", fields: [visitorId], references: [id])

  @@index([profileUserId])
  @@index([visitorId])
  @@index([createdAt])
  @@index([source])
}

model ContentShare {
  id          String   @id @default(cuid())
  contentId   String
  contentType String
  sharerId    String
  shareType   String
  platform    String?
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  sharer      User     @relation(fields: [sharerId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([sharerId])
  @@index([createdAt])
}

model CreatorInsight {
  id                 String   @id @default(cuid())
  userId             String   @unique
  followersTotal     Int      @default(0)
  followers7d        Int      @default(0)
  followers30d       Int      @default(0)
  avgEngagementRate  Float    @default(0)
  avgVideoCompletion Float    @default(0)
  bestPostingHour    Int?
  bestPostingDay     Int?
  bestContentType    String?
  followerViewRate   Float    @default(0)
  topContentIds      String[]
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PhotoComment {
  id        String      @id @default(cuid())
  userId    String
  photoId   String?
  albumId   String?
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  album     PhotoAlbum? @relation(fields: [albumId], references: [id], onDelete: Cascade)
  photo     Photo?      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@index([albumId])
  @@index([userId])
}

model Album {
  id                              String              @id
  userId                          String
  title                           String
  description                     String?
  coverMediaId                    String?             @unique
  defaultVisibility               Visibility          @default(FRIENDS_ONLY)
  discoveryEnabled                Boolean             @default(false)
  featured                        Boolean             @default(false)
  createdAt                       DateTime            @default(now())
  updatedAt                       DateTime
  Media_Album_coverMediaIdToMedia Media?              @relation("Album_coverMediaIdToMedia", fields: [coverMediaId], references: [id])
  User                            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  AlbumFeedCooldown               AlbumFeedCooldown[]
  Media_Media_albumIdToAlbum      Media[]             @relation("Media_albumIdToAlbum")

  @@index([discoveryEnabled, createdAt])
  @@index([userId, createdAt])
}

model AlbumFeedCooldown {
  id        String   @id
  userId    String
  albumId   String?
  expiresAt DateTime
  Album     Album?   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([userId, expiresAt])
}

model BlockedTagger {
  id                                     String   @id
  blockedById                            String
  blockedUserId                          String
  createdAt                              DateTime @default(now())
  User_BlockedTagger_blockedByIdToUser   User     @relation("BlockedTagger_blockedByIdToUser", fields: [blockedById], references: [id], onDelete: Cascade)
  User_BlockedTagger_blockedUserIdToUser User     @relation("BlockedTagger_blockedUserIdToUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockedById, blockedUserId])
  @@index([blockedById])
}

model Media {
  id                              String            @id
  albumId                         String
  uploaderId                      String
  type                            MediaType
  cloudinaryId                    String            @unique
  url                             String
  width                           Int?
  height                          Int?
  visibility                      Visibility        @default(FRIENDS_ONLY)
  duration                        Int?
  thumbnailUrl                    String?
  thumbnailOffset                 Int?
  hlsUrl                          String?
  mp4UrlHd                        String?
  mp4UrlSd                        String?
  processingStatus                VideoStatus?
  discoveryEnabled                Boolean           @default(true)
  caption                         String?
  locationName                    String?
  latitude                        Float?
  longitude                       Float?
  takenAt                         DateTime?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime
  Album_Album_coverMediaIdToMedia Album?            @relation("Album_coverMediaIdToMedia")
  Album_Media_albumIdToAlbum      Album             @relation("Media_albumIdToAlbum", fields: [albumId], references: [id], onDelete: Cascade)
  User                            User              @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  MediaComment                    MediaComment[]
  MediaImpression                 MediaImpression[]
  MediaReaction                   MediaReaction[]
  MediaReport                     MediaReport[]
  MediaTag                        MediaTag[]

  @@index([albumId, createdAt])
  @@index([processingStatus])
  @@index([uploaderId, createdAt])
  @@index([visibility, discoveryEnabled, createdAt])
}

model MediaComment {
  id                 String         @id
  mediaId            String
  userId             String
  parentId           String?
  content            String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  imageUrl           String?
  Media              Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  MediaComment       MediaComment?  @relation("MediaCommentToMediaComment", fields: [parentId], references: [id], onDelete: Cascade)
  other_MediaComment MediaComment[] @relation("MediaCommentToMediaComment")
  User               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt])
  @@index([parentId])
}

model MediaImpression {
  id        String           @id
  mediaId   String
  userId    String?
  source    ImpressionSource
  createdAt DateTime         @default(now())
  Media     Media            @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  User      User?            @relation(fields: [userId], references: [id])

  @@index([mediaId, createdAt])
  @@index([userId, createdAt])
}

model MediaReaction {
  id        String       @id
  mediaId   String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  Media     Media        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  User      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId, type])
  @@index([mediaId])
}

model MediaReport {
  id          String       @id
  mediaId     String
  reporterId  String
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime     @default(now())
  Media       Media        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  User        User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([status, createdAt])
}

model MediaTag {
  id                               String    @id
  mediaId                          String
  taggedById                       String
  taggedUserId                     String
  status                           TagStatus @default(PENDING)
  positionX                        Float?
  positionY                        Float?
  createdAt                        DateTime  @default(now())
  respondedAt                      DateTime?
  Media                            Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  User_MediaTag_taggedByIdToUser   User      @relation("MediaTag_taggedByIdToUser", fields: [taggedById], references: [id], onDelete: Cascade)
  User_MediaTag_taggedUserIdToUser User      @relation("MediaTag_taggedUserIdToUser", fields: [taggedUserId], references: [id], onDelete: Cascade)

  @@unique([mediaId, taggedUserId])
  @@index([mediaId])
  @@index([taggedUserId, status, createdAt])
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  subject     String?
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([isRead])
}

model ThingToDo {
  id                    String                @id @default(cuid())
  type                  ThingType             @default(OTHER)
  title                 String
  description           String?
  lat                   Float?
  lng                   Float?
  address               String?
  startAt               DateTime?
  endAt                 DateTime?
  priceMin              Float?
  priceMax              Float?
  sourceUrl             String                @unique
  sourceName            String
  placeId               String?
  imageUrl              String?
  tags                  String[]
  qualityScore          Int                   @default(50)
  status                ThingStatus           @default(ACTIVE)
  createdByUserId       String?
  capturedAt            DateTime              @default(now())
  lastVerifiedAt        DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdByCampgroundId String?
  campgrounds           CampgroundThingToDo[]
  createdBy             User?                 @relation("ThingsCreated", fields: [createdByUserId], references: [id])
  saves                 ThingToDoSave[]
  votes                 ThingToDoVote[]
  eventActivities       EventActivity[]

  @@index([type])
  @@index([status])
  @@index([lat, lng])
  @@index([placeId])
}

model CampgroundThingToDo {
  id             String     @id @default(cuid())
  campgroundId   String
  thingToDoId    String
  distanceMiles  Float?
  relevanceScore Int        @default(50)
  pinned         Boolean    @default(false)
  createdAt      DateTime   @default(now())
  displayOrder   Int        @default(0)
  pinnedAt       DateTime?
  pinnedById     String?
  pinnedUntil    DateTime?
  campground     Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)
  thingToDo      ThingToDo  @relation(fields: [thingToDoId], references: [id], onDelete: Cascade)

  @@unique([campgroundId, thingToDoId])
  @@index([campgroundId])
  @@index([thingToDoId])
}

model ThingToDoSave {
  id          String    @id @default(cuid())
  userId      String
  thingToDoId String
  note        String?
  createdAt   DateTime  @default(now())
  thingToDo   ThingToDo @relation(fields: [thingToDoId], references: [id], onDelete: Cascade)
  user        User      @relation("SavedThings", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, thingToDoId])
  @@index([userId])
}

model ThingToDoVote {
  id          String    @id @default(cuid())
  userId      String
  thingToDoId String
  value       Int
  createdAt   DateTime  @default(now())
  thingToDo   ThingToDo @relation(fields: [thingToDoId], references: [id], onDelete: Cascade)
  user        User      @relation("ThingVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, thingToDoId])
}

model Advertiser {
  id         String    @id
  name       String
  email      String    @unique
  company    String
  logoUrl    String?
  websiteUrl String?
  balance    Decimal?  @default(0) @db.Decimal(10, 2)
  isActive   Boolean?  @default(true)
  createdAt  DateTime? @default(now()) @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @db.Timestamp(6)
  GearAd     GearAd[]
}

model AffiliateClick {
  id               String    @id
  userId           String?
  gearItemId       String?
  gearAdId         String?
  retailer         String
  productUrl       String
  affiliateUrl     String
  sessionId        String?
  createdAt        DateTime? @default(now()) @db.Timestamp(6)
  convertedAt      DateTime? @db.Timestamp(6)
  conversionAmount Decimal?  @db.Decimal(10, 2)
  GearAd           GearAd?   @relation(fields: [gearAdId], references: [id], onUpdate: NoAction)
  GearItem         GearItem? @relation(fields: [gearItemId], references: [id], onUpdate: NoAction)
  User             User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([userId])
}

model GearAd {
  id                  String           @id
  advertiserId        String
  name                String
  brand               String
  description         String?
  imageUrl            String
  linkUrl             String
  affiliateUrl        String?
  category            String
  targetCampingStyles String[]         @default([])
  bidAmount           Decimal          @db.Decimal(10, 4)
  dailyBudget         Decimal?         @db.Decimal(10, 2)
  totalBudget         Decimal?         @db.Decimal(10, 2)
  spent               Decimal?         @default(0) @db.Decimal(10, 2)
  impressions         Int?             @default(0)
  clicks              Int?             @default(0)
  isActive            Boolean?         @default(true)
  startDate           DateTime         @db.Timestamp(6)
  endDate             DateTime?        @db.Timestamp(6)
  createdAt           DateTime?        @default(now()) @db.Timestamp(6)
  updatedAt           DateTime?        @default(now()) @db.Timestamp(6)
  AffiliateClick      AffiliateClick[]
  Advertiser          Advertiser       @relation(fields: [advertiserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  GearAdEvent         GearAdEvent[]

  @@index([category])
  @@index([isActive])
}

model GearAdEvent {
  id        String    @id
  adId      String
  userId    String?
  eventType String
  sessionId String?
  ipHash    String?
  userAgent String?
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  GearAd    GearAd    @relation(fields: [adId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User      User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([adId])
}

model CampgroundWishlist {
  id           String     @id
  userId       String
  campgroundId String
  notes        String?
  priority     Int?       @default(0)
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campground   Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)

  @@unique([userId, campgroundId])
  @@index([campgroundId])
  @@index([userId])
}

enum ThingType {
  TRAIL
  EVENT
  ATTRACTION
  FOOD
  TOUR
  OTHER
}

enum ThingStatus {
  ACTIVE
  NEEDS_REVIEW
  EXPIRED
}

enum CampgroundTier {
  FREE
  CLASS_C
  CLASS_B
  CLASS_A
}

enum ClaimStatus {
  UNCLAIMED
  PENDING
  VERIFIED
  REJECTED
}

enum AdminRole {
  OWNER
  ADMIN
  MODERATOR
}

enum AnnouncementPriority {
  LOW
  NORMAL
  IMPORTANT
  URGENT
}

enum AllowTagsFrom {
  EVERYONE
  FRIENDS_ONLY
  NO_ONE
}

enum ImpressionSource {
  FEED
  PROFILE
  ALBUM
  DISCOVERY
  DIRECT_LINK
}

enum MediaType {
  PHOTO
  VIDEO
}

enum ReactionType {
  LIKE
  LOVE
  THUMBS_UP
  THUMBS_DOWN
}

enum ReportReason {
  INAPPROPRIATE
  SPAM
  HARASSMENT
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  REMOVED
  DISMISSED
}

enum TagApprovalMode {
  AUTO_APPROVE
  MANUAL_APPROVE
}

enum TagStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum TaggedMediaVisibility {
  SHOW_IN_FEED
  PHOTOS_TAB_ONLY
  HIDDEN
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

enum Visibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

model EventActivity {
  id            String    @id @default(cuid())
  eventId       String
  thingToDoId   String
  scheduledDate DateTime?
  scheduledTime String?
  duration      Int?      // minutes
  notes         String?
  status        String    @default("PLANNED") // PLANNED, COMPLETED, SKIPPED
  addedById     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  thingToDo     ThingToDo @relation(fields: [thingToDoId], references: [id], onDelete: Cascade)
  addedBy       User      @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([eventId, thingToDoId])
  @@index([eventId])
  @@index([thingToDoId])
}


model BadgeCampground {
  id           String     @id @default(cuid())
  badgeId      String
  campgroundId String
  badge        Badge      @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  campground   Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([badgeId, campgroundId])
  @@index([badgeId])
  @@index([campgroundId])
}
