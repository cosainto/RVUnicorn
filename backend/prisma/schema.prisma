  phone       String?
  website     String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([state])
  @@index([interstate])
  @@index([brand])
  @@index([latitude, longitude])
}

// Rest Stops (state-run rest areas)
model RestStop {
  id          String   @id @default(cuid())
