  @@index([episodeId])
  @@index([stopId])
  @@index([bundleId])
  @@index([rigId, createdAt])
}

model RigMilestone {
  id             String   @id @default(cuid())
  rigId          String
  milestoneType  String   // states, nights, trips, miles
  value          Int
  achievedAt     DateTime @default(now())
  @@unique([rigId, milestoneType, value])
  @@index([rigId])
}

model ModAffiliateClick {
  id          String   @id @default(cuid())
  userId      String?
  modLogId    String
  rigId       String
  productUrl  String
  clickedAt   DateTime @default(now())
  @@index([modLogId])
  @@index([rigId])
}

model CheckInInvite {
