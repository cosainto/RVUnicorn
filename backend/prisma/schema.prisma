model CampgroundPriceReport {
  id           String     @id @default(cuid())
  campgroundId String
  userId       String
  // Per-night dollar amount the user reported paying. Stored as Float
  // for symmetry with Campground.pricePerNight; we don't need cent precision.
  pricePaid    Float
  // Optional context so the same campground can have multiple realistic
  // rates for different site types / hookup levels / seasons. None of
  // these are required — power users can fill them in but a quick "I
  // paid $45" still works.
  siteType     String?    // 'TENT' | 'RV_NO_HOOKUPS' | 'RV_PARTIAL' | 'RV_FULL' | 'CABIN' | 'OTHER'
  hookupLevel  String?    // 'NONE' | 'WATER' | 'WATER_ELEC' | 'FULL'
  season       String?    // 'WINTER' | 'SPRING' | 'SUMMER' | 'FALL' | 'PEAK' | 'OFF_PEAK'
  notes        String?
  reportedAt   DateTime   @default(now())
  campground   Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campgroundId])
  @@index([userId])
  @@index([reportedAt])
}

