  tripId          String
  fromStopId      String
  toStopId        String
  distanceMiles   Float
  durationMinutes Int?
  roadType        String   @default("MIXED") // HIGHWAY | SCENIC | OFFGRID | MIXED
  polyline        String?
  fuelStops       Int      @default(0)
  highlight       String?
  drivenAt        DateTime
  createdAt       DateTime @default(now())

  trip            RigTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model RigTripMilestone {
  id            String   @id @default(cuid())
  tripId        String
  rigId         String
  milestoneType String   // MILES_100 | MILES_500 | MILES_1000 | NEW_STATE | NEW_PARK | CAMPGROUND_10 | LONGEST_DRIVE | FAVORITE_RETURN | CUSTOM
  title         String
  description   String?
  value         String?
  occurredAt    DateTime
  stopId        String?
  lat           Float?
  lng           Float?
  createdAt     DateTime @default(now())

  trip          RigTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  rig           Rig      @relation(fields: [rigId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model RigTripMember {
  id       String   @id @default(cuid())
  tripId   String
  userId   String
  joinedAt DateTime @default(now())
  role     String   @default("DRIVER") // DRIVER | COPILOT | CREW

  trip     RigTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}
