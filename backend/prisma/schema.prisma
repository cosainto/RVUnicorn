model Post {
  id             String          @id @default(cuid())
  content        String
  imageUrl       String?
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  wallOwnerId    String?
  groupId        String?
  comments       Comment[]
  likes          Like[]
  mentions       Mention[]
  pinnedComments PinnedComment[]
  group          Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallOwner      User?           @relation("WallPosts", fields: [wallOwnerId], references: [id], onDelete: Cascade)
  hashtags       PostHashtag[]
  reactions      Reaction[]

  @@index([userId])
  @@index([wallOwnerId])
  @@index([createdAt])
}

model Comment {
  id            String         @id @default(cuid())
  content       String
  postId        String
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  editHistory   Json?
  imageUrl      String?
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies       CommentReply[] @relation("CommentReplies")
  pinnedComment PinnedComment?
  reactions     Reaction[]

  @@index([postId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Friendship {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  status      String   @default("PENDING")
  initiatorId String
  receiverId  String
  updatedAt   DateTime @updatedAt
  initiator   User     @relation("FriendshipInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver    User     @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, receiverId])
  @@index([initiatorId])
  @@index([receiverId])
  @@index([status])
}

model Trip {
  id          String       @id @default(cuid())
  userId      String
  eventId     String?
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  title       String
  status      String       @default("PLANNING")
  visibility  String       @default("PRIVATE")
  coverImage  String?
  shareToken  String?      @unique
  stays                Stay[]
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  days                 TripDay[]
  members              TripMember[]
  confidenceSnapshots  TripConfidenceSnapshot[]

  @@index([userId])
  @@index([startDate])
}

model TripDay {
  id        String     @id @default(cuid())
  tripId    String
  date      DateTime?
  dayNumber Int
  type      String     @default("TRAVEL")
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  trip      Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stops     TripStop[]

  @@index([tripId])
}

model TripStop {
  id                 String      @id @default(cuid())
  tripDayId          String
  order              Int
  type               String
  campgroundId       String?
  customName         String?
  address            String?
  latitude           Float?
  longitude          Float?
  notes              String?
  siteNumber         String?
  confirmationNumber String?
  durationMins       Int?
  cost               Float?
  confirmed          Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  campground   Campground? @relation(fields: [campgroundId], references: [id])
  tripDay      TripDay     @relation(fields: [tripDayId], references: [id], onDelete: Cascade)

  @@index([tripDayId])
  @@index([campgroundId])
}

model TripMember {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  role      String   @default("VIEWER")
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
}

model Campground {
  id                     String                   @id @default(cuid())
  name                   String
  description            String?
  location               String
  state                  String?
  latitude               Float?
  longitude              Float?
  amenities              String[]
  createdAt              DateTime                 @default(now())
