  eventId          String?
  sessionId        String?
  originLat        Float
  originLon        Float
  destLat          Float
  destLon          Float
  totalMiles       Float
  totalHours       Float
  segments         Json     // array of RouteSegment objects
  overallScore     Int      // composite 0-100
  safetyScore      Int      // 0-100
  comfortScore     Int      // 0-100
  convenienceScore Int      // 0-100
  flexibilityScore Int      // 0-100
  status           String   // GO | CAUTION | NO_GO
  headline         String?
  flags            Json?    // array of RiskFlag objects
  passedChecks     Json?    // array of strings
  routePolyline    String?  // HERE flexible polyline
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([userId])
  @@index([eventId])
  @@index([createdAt])
}

model LiveCoPilotSession {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId         String?
  corridorId      String?
  originLat       Float
  originLon       Float
  destLat         Float
  destLon         Float
  currentLat      Float?
  currentLon      Float?
  currentSegment  Int       @default(0)
  status          String    @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | SAVE_ME
  milesDriven     Float     @default(0)
  startedAt       DateTime  @default(now())
  lastPingAt      DateTime  @default(now())
  endedAt         DateTime?
  alerts          CoPilotAlert[]

  @@index([userId])
  @@index([status])
}

model CoPilotAlert {
  id            String   @id @default(cuid())
  sessionId     String
  session       LiveCoPilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type          String   // WIND | FATIGUE | FUEL_LOW | OVERNIGHT | WEATHER | SAVE_ME
  urgency       String   // INFO | WARNING | CRITICAL
  title         String
  body          String
  actionLabel   String?
  actionPayload Json?
  dismissed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([sessionId])
  @@index([type])
}

model Rig {
