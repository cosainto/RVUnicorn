model RigTripStop {
  id                    String    @id @default(cuid())
  tripId                String
  rigId                 String
  campgroundId          String?
  name                  String
  city                  String?
  state                 String?
  country               String    @default("US")
  lat                   Float?
  lng                   Float?
  arrivedAt             DateTime
  departedAt            DateTime?
  nightsStayed          Int       @default(0)
  order                 Int       @default(0)
  milesFromPreviousStop Float?
  driveTimeMinutes      Int?
  coverImageUrl         String?
  featuredMomentId      String?
  photoCount            Int       @default(0)
  videoCount            Int       @default(0)
  reviewCount           Int       @default(0)
  memberCount           Int       @default(0)
  summary               String?
  isCurrentStop         Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  trip                  RigTrip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

