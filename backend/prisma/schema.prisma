  campground    Campground  @relation(fields: [campgroundId], references: [id], onDelete: Cascade)
  date          DateTime    @default(now())
  eventType     String
  userId        String?
  source        String?
  metadata      Json?

  @@index([campgroundId, date])
  @@index([eventType])
}

// Photo Tags - Tag users in photos
model PhotoTag {
  id        String   @id @default(cuid())
  photoId   String
  userId    String   // User being tagged
  taggedBy  String   // User who created the tag
  x         Float?   // Optional x position (0-100 percentage)
  y         Float?   // Optional y position (0-100 percentage)
  createdAt DateTime @default(now())

  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user      User     @relation("PhotoTagsReceived", fields: [userId], references: [id], onDelete: Cascade)
  tagger    User     @relation("PhotoTagsCreated", fields: [taggedBy], references: [id], onDelete: Cascade)

  @@unique([photoId, userId]) // Can only tag a user once per photo
  @@index([photoId])
  @@index([userId])
}

// Photo Campground Tags - Tag campgrounds in photos
model PhotoCampgroundTag {
  id           String   @id @default(cuid())
  photoId      String
  campgroundId String
  taggedBy     String   // User who created the tag
  createdAt    DateTime @default(now())

  photo      Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  campground Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)
  tagger     User       @relation("CampgroundPhotoTagsCreated", fields: [taggedBy], references: [id], onDelete: Cascade)

  @@unique([photoId, campgroundId]) // Can only tag a campground once per photo
  @@index([photoId])
  @@index([campgroundId])
}

// Emoji Reactions for posts and comments
model Reaction {
  id        String   @id @default(cuid())
  type      String   // like, love, haha, wow, campy, fire
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId, type])
  @@unique([userId, commentId, type])
  @@index([postId])
  @@index([commentId])
}

// Hashtags for topic categorization
model Hashtag {
  id        String        @id @default(cuid())
  tag       String        @unique // lowercase, no #
  postCount Int           @default(0)
  createdAt DateTime      @default(now())
  posts     PostHashtag[]
}

model PostHashtag {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, hashtagId])
}

// Comment replies (for threaded comments)
model CommentReply {
  id              String    @id @default(cuid())
  content         String
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId       String
  parentComment   Comment   @relation("CommentReplies", fields: [commentId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  editHistory     Json?     // Array of {content, editedAt}
}

// Pinned comments
model PinnedComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String   @unique
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  pinnedBy  String
  user      User     @relation(fields: [pinnedBy], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, commentId])
}

model BlockedUser {
  id            String   @id @default(cuid())
  userId        String
  blockedUserId String
  reason        String?
  createdAt     DateTime @default(now())

  user        User @relation("UserBlocks", fields: [userId], references: [id], onDelete: Cascade)
  blockedUser User @relation("BlockedByUsers", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId])
  @@index([userId])
  @@index([blockedUserId])
}

model AccountActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  ipAddress   String?
  userAgent   String?
  details     String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])

  @@index([createdAt])
}

model AccountDeletion {
  id                    String    @id @default(cuid())
  userId                String    @unique
  reason                String?
  feedback              String?
  requestedAt           DateTime  @default(now())
  scheduledDeletionDate DateTime
  cancelledAt           DateTime?
  status                String    @default("PENDING")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([scheduledDeletionDate])
}

model EmailVerification {
  id          String   @id @default(cuid())
  userId      String
  email       String
  token       String   @unique
  type        String
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ============================================
// BADGE SYSTEM
// ============================================

model Badge {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  description   String
  imageUrl      String
  category      String      @default("GENERAL")
  requirement   String?
  triggerType   String
  triggerValue  Int?
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userBadges    UserBadge[]

  @@index([slug])
  @@index([triggerType])
  @@index([isActive])
}

model UserBadge {
  id          String    @id @default(cuid())
  userId      String
  badgeId     String
  earnedAt    DateTime  @default(now())
  progress    Int?
  notified    Boolean   @default(false)
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([earnedAt])
}

// ============================================
// EXPANDED PACKING LIST SYSTEM
// ============================================

model InventoryItem {
  id          String   @id @default(cuid())
  userId      String
  name        String
  category    String   @default("General")
  quantity    Int      @default(1)
  notes       String?
  cookId      String?
  cookStatus  String?   @default("PENDING")  // PENDING, ACCEPTED, DECLINED, UNDECIDED
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripPackItems TripPackItem[]

  @@index([userId])
  @@index([category])
}

model TripPackItem {
  id               String    @id @default(cuid())
  tripId           String?
  eventId          String?
  inventoryItemId  String?
  customName       String?
  customCategory   String?
  quantity         Int       @default(1)
  isPacked         Boolean   @default(false)
  packedAt         DateTime?
  packedById       String?
  assignedToId     String?
  assignmentStatus String    @default("PENDING")
  declinedAt       DateTime?
  declineReason    String?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  trip          TripPlan?      @relation("TripPackItems", fields: [tripId], references: [id], onDelete: Cascade)
  event         Event?         @relation("EventTripPackItems", fields: [eventId], references: [id], onDelete: Cascade)
  assignedTo    User?          @relation("AssignedTripPackItems", fields: [assignedToId], references: [id], onDelete: SetNull)
  packedBy      User?          @relation("PackedByTripPackItems", fields: [packedById], references: [id], onDelete: SetNull)
  createdBy     User           @relation("CreatedTripPackItems", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([eventId])
  @@index([assignedToId])
  @@index([inventoryItemId])
  @@index([isPacked])
}

model PackingListTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  privacy     String   @default("PRIVATE")
  items       Json
  copiedCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([privacy])
}

model BasecampActivity {
  id         String   @id @default(cuid())
  userId     String
  actorId    String
  type       String
  entityType String
  entityId   String
  entityName String?
  metadata   Json?
  isRead     Boolean  @default(false)
  reaction   String?  // 'like', 'love', 'dislike', or null
  createdAt  DateTime @default(now())

  user  User @relation("BasecampActivityRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("BasecampActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// ============================================
// CREATOR PAGES SYSTEM
// ============================================

model CreatorContent {
  id              String   @id @default(cuid())
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  contentType     String
  title           String?
  description     String?
  body            String?
  
  thumbnailUrl    String?
  videoUrl        String?
  embedUrl        String?
  embedPlatform   String?
  
  category        String?
  tags            String[]
  
  campgroundId    String?
  campground      Campground? @relation(fields: [campgroundId], references: [id])
  eventId         String?
  tripId          String?
  
  isSponsored     Boolean  @default(false)
  sponsorName     String?
  affiliateLinks  Json?
  
  status          String   @default("DRAFT")
  publishedAt     DateTime?
  
  viewCount       Int      @default(0)
  likeCount       Int      @default(0)
  commentCount    Int      @default(0)
  repostCount     Int      @default(0)
  saveCount       Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  likes           CreatorContentLike[]
  comments        CreatorContentComment[]
  reposts         CreatorRepost[]
  saves           CreatorSave[]
  photos          CreatorContentPhoto[]
  gearItems       CreatorContentGear[]
  taggedUsers     CreatorContentTag[]
  collaborators   CreatorCollaboration[]
  
  @@index([creatorId])
  @@index([category])
  @@index([status, publishedAt])
  @@index([campgroundId])
}

model CreatorContentPhoto {
  id              String   @id @default(cuid())
  contentId       String
  content         CreatorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  imageUrl        String
  caption         String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  
  @@index([contentId])
}

model CreatorContentGear {
  id              String   @id @default(cuid())
  contentId       String
  content         CreatorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  gearItemId      String?
  name            String
  description     String?
  imageUrl        String?
  affiliateUrl    String?
  createdAt       DateTime @default(now())
  
  @@index([contentId])
}

model CreatorContentTag {
  id              String   @id @default(cuid())
  contentId       String
  content         CreatorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tagType         String
  userId          String?
  user            User?    @relation("TaggedInContent", fields: [userId], references: [id])
  campgroundId    String?
  campground      Campground? @relation("TaggedCampground", fields: [campgroundId], references: [id])
  brandName       String?
  createdAt       DateTime @default(now())
  
  @@unique([contentId, tagType, userId])
  @@unique([contentId, tagType, campgroundId])
  @@index([contentId])
  @@index([userId])
  @@index([campgroundId])
}

model CreatorCollaboration {
  id              String   @id @default(cuid())
  contentId       String
  content         CreatorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  collaboratorId  String
  collaborator    User     @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  role            String   @default("COLLABORATOR")
  createdAt       DateTime @default(now())
  
  @@unique([contentId, collaboratorId])
  @@index([collaboratorId])
}

model CreatorFollow {
  id              String   @id @default(cuid())
  creatorId       String
  creator         User     @relation("CreatorFollowers", fields: [creatorId], references: [id], onDelete: Cascade)
  followerId      String
  follower        User     @relation("FollowingCreators", fields: [followerId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  
  @@unique([creatorId, followerId])
  @@index([creatorId])
  @@index([followerId])
}

model CreatorContentLike {
  id              String   @id @default(cuid())
  contentId       String
  content         CreatorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  
  @@unique([contentId, userId])
  @@index([contentId])
  @@index([userId])
}

model CreatorContentComment {
  id              String   @id @default(cuid())
  contentId       String
  content         CreatorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body            String
  parentId        String?
  parent          CreatorContentComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         CreatorContentComment[] @relation("CommentReplies")
  isCreatorReply  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([contentId])
  @@index([userId])
  @@index([parentId])
}

model CreatorRepost {
  id              String   @id @default(cuid())
  contentId       String
  content         CreatorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment         String?
  createdAt       DateTime @default(now())
  
  @@unique([contentId, userId])
  @@index([contentId])
  @@index([userId])
}

model CreatorSave {
  id              String   @id @default(cuid())
  contentId       String
  content         CreatorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  
  @@unique([contentId, userId])
  @@index([userId])
}

model CreatorStats {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalViews      Int      @default(0)
  totalLikes      Int      @default(0)
  totalComments   Int      @default(0)
  totalReposts    Int      @default(0)
  totalSaves      Int      @default(0)
  followerCount   Int      @default(0)
  viewsThisWeek   Int      @default(0)
  viewsThisMonth  Int      @default(0)
  followersThisWeek Int    @default(0)
  followersThisMonth Int   @default(0)
  lastCalculatedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Creator Page Collaborators - allows multiple users to manage a creator page
model CreatorPageCollaborator {
  id              String   @id @default(cuid())
  creatorId       String   // The creator page owner
  creator         User     @relation("CreatorPageOwner", fields: [creatorId], references: [id], onDelete: Cascade)
  collaboratorId  String   // The user who can also manage this page
  collaborator    User     @relation("CreatorPageCollaborator", fields: [collaboratorId], references: [id], onDelete: Cascade)
  role            String   @default("COLLABORATOR") // COLLABORATOR, ADMIN
  canPost         Boolean  @default(true)
  canEdit         Boolean  @default(true)
  canDelete       Boolean  @default(false)
  canManageCollaborators Boolean @default(false)
  createdAt       DateTime @default(now())
  
  @@unique([creatorId, collaboratorId])
  @@index([collaboratorId])
  @@index([creatorId])
}

model BookingClick {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campgroundId   String
  campground     Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)
  clickedAt      DateTime   @default(now())
  followUpSentAt DateTime?
  responded      Boolean    @default(false)
  didBook        Boolean?
  createdEventId String?
  
  @@index([userId])
  @@index([campgroundId])
  @@index([clickedAt])
}


// Recipe Comment Mute - Users can mute notifications for specific recipes
model RecipeCommentMute {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
}


// Event Comment Mute - Users can mute notifications for specific events
model EventCommentMute {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// Event Blocked Users - Event creator can restrict specific users from accessing event
model EventBlockedUser {
  id        String   @id @default(cuid())
  eventId   String
  userId    String   // User who is blocked
  blockedBy String   // Event creator who blocked them
  reason    String?
  createdAt DateTime @default(now())

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User  @relation("BlockedFromEvents", fields: [userId], references: [id], onDelete: Cascade)
  blocker User  @relation("EventBlocker", fields: [blockedBy], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Event Subtab Privacy - Per-subtab privacy settings
model EventSubtabPrivacy {
  id        String   @id @default(cuid())
  eventId   String
  subtab    String   // DETAILS, MEAL_PLAN, PACKING_LIST, DISCUSSIONS, PHOTOS, ATTENDEES
  privacy   String   @default("INHERIT") // INHERIT (use event privacy), PUBLIC, FRIENDS, PRIVATE, ATTENDEES_ONLY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, subtab])
  @@index([eventId])
}

model ActivityLike {
  reaction   String?  // like, love, dislike
  id         String   @id @default(cuid())
  activityId String
  userId     String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
}

model RecipeLike {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
}

model RecipeCommentLike {
  reaction  String?  // like, love, dislike
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment RecipeComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model ThreadIgnore {
  id        String    @id @default(cuid())
  userId    String
  threadId  String
  expiresAt DateTime? // null means permanent ignore
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
  @@index([threadId])
  @@index([expiresAt])
}

