  location         String?
  bundledAt        DateTime @default(now())
  mediaHash        String?
  createdAt        DateTime @default(now())

  rig              Rig      @relation(fields: [rigId], references: [id], onDelete: Cascade)

  @@index([rigId, stopId])
}

model RigActivityItem {
  id             String   @id @default(cuid())
  rigId          String
  activityType   String   // PHOTO_MOMENT | CHECKIN | ROUTE_SEGMENT | MILEAGE_EVENT | MILESTONE | MAINTENANCE | STORY
  refId          String
  refType        String
  stopId         String?
  routeSegmentId String?
  bundleId       String?
  lat            Float?
  lng            Float?
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  rig            Rig      @relation(fields: [rigId], references: [id], onDelete: Cascade)

  @@index([rigId, occurredAt])
}

model RigInsightCard {
  id                String   @id @default(cuid())
  rigId             String
  tripId            String?
  cardType          String   // MILEAGE | STREAK | MILESTONE | STATE_CROSS | PARK_ENTRY | STATS
  content           Json
  displayAfterStopId String?
  generatedAt       DateTime @default(now())

  rig               Rig      @relation(fields: [rigId], references: [id], onDelete: Cascade)

  @@index([rigId])
}

// ═══ Rig Trip Mode v2 ═══

model RigTrip {
  id                    String            @id @default(cuid())
  rigId                 String
  name                  String
  description           String?
  status                String            @default("ACTIVE") // ACTIVE | COMPLETED | ARCHIVED
  startDate             DateTime?
  endDate               DateTime?
  coverImageUrl         String?
  totalMiles            Float             @default(0)
  totalNights           Int               @default(0)
  statesVisited         String[]
  nationalParksVisited  String[]
  campgroundCount       Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  rig                   Rig               @relation(fields: [rigId], references: [id], onDelete: Cascade)
  stops                 RigTripStop[]
  routes                RigTripRoute[]
