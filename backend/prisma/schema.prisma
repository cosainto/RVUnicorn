generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                              String                    @id @default(cuid())
  email                                           String                    @unique
  username                                        String                    @unique
  password                                        String
  bio                                             String?
  location                                        String?
  profilePicture                                  String?
  coverPhoto                                      String?
  createdAt                                       DateTime                  @default(now())
  updatedAt                                       DateTime                  @updatedAt
  firstName                                       String
  lastName                                        String
  rvMake                                          String?
  rvModel                                         String?
  rvType                                          String?
  rvYear                                          Int?
  website                                         String?
  facebookUrl                                     String?
  instagramUrl                                    String?
  redditUrl                                       String?
  tiktokUrl                                       String?
  youtubeUrl                                      String?
  currentCampsite                                 String?
  status                                          String?
  statusEmoji                                     String?
  statusType                                      String?
  blueskyUrl                                      String?
  twitterUrl                                      String?
  rvDescription                                   String?
  rvFeatures                                      String[]
  rvLength                                        Int?
  rvMpg                                           Float?
  rvTankGallons                                   Float?
  rvHeight                                        Int?
  rvWeight                                        Int?
  rvSleeps                                        Int?
  rvSlideouts                                     Int?
  showCampingStatus                               Boolean                   @default(true)
  lastActiveAt                                    DateTime?
  creatorBio                                      String?
  creatorCoverImage                               String?
  creatorEnabledAt                                DateTime?
  creatorFeatured                                 Boolean                   @default(false)
  creatorSpecialties                              String[]
  creatorVerified                                 Boolean                   @default(false)
  isCreator                                       Boolean                   @default(false)
  showSocialOnCreator                             Boolean                   @default(true)
  showSocialOnProfile                             Boolean                   @default(true)
  creatorDisplayName                              String?
  creatorHandle                                   String?
  hasPets                                         Boolean                   @default(false)
  homeAddress                                     String?
  homeCity                                        String?
  homeCountry                                     String?                   @default("USA")
  homeLatitude                                    Float?
  homeLongitude                                   Float?
  homeState                                       String?
  homeZipCode                                     String?
  onboardingCompleted                             Boolean                   @default(false)
  onboardingStep                                  Int                       @default(0)
  petTypes                                        String[]                  @default([])
  preferredTripLength                             String?
  travelPartySize                                 Int?
  travelPartyType                                 String?
  licensePlate                                    String?
  licensePlateState                               String?
  rvWidth                                         Int?
  tagExpiration                                   DateTime?
  rvOdometer                                      Int?
  taggedMediaVisibility                           TaggedMediaVisibility     @default(SHOW_IN_FEED)
  tagApprovalMode                                 TagApprovalMode           @default(AUTO_APPROVE)
  allowTagsFrom                                   AllowTagsFrom             @default(EVERYONE)
  contentInterests                                String[]
  campingStyles                                   String[]                  @default([])
  activityLogs                                    AccountActivityLog[]
  accountDeletion                                 AccountDeletion?
  activitySecondary                               Activity[]                @relation("ActivitySecondaryUser")
  activityTargets                                 Activity[]                @relation("ActivityTarget")
  activities                                      Activity[]
  activityLikes                                   ActivityLike[]
  eventActivities                                 EventActivity[]
  AffiliateClick                                  AffiliateClick[]
  Album                                           Album[]
  AlbumFeedCooldown                               AlbumFeedCooldown[]
  attractions                                     Attraction[]
  basecampActivitiesPerformed                     BasecampActivity[]        @relation("BasecampActivityActor")
  basecampActivitiesReceived                      BasecampActivity[]        @relation("BasecampActivityRecipient")
  BlockedTagger_BlockedTagger_blockedByIdToUser   BlockedTagger[]           @relation("BlockedTagger_blockedByIdToUser")
  BlockedTagger_BlockedTagger_blockedUserIdToUser BlockedTagger[]           @relation("BlockedTagger_blockedUserIdToUser")
  blockedByUsers                                  BlockedUser[]             @relation("BlockedByUsers")
  blockedUsers                                    BlockedUser[]             @relation("UserBlocks")
  bookingClicks                                   BookingClick[]
  claimedCampgrounds                              Campground[]              @relation("ClaimedCampgrounds")
  campgroundAdmins                                CampgroundAdmin[]
  campgroundAnnouncements                         CampgroundAnnouncement[]
  campgroundEvents                                CampgroundEvent[]
  campgroundFollows                               CampgroundFollow[]
  campgroundWishlists                             CampgroundWishlist[]
  reviewedPhotos                                  CampgroundPhoto[]         @relation("PhotoReviewer")
  campgroundPhotos                                CampgroundPhoto[]
  campgroundPosts                                 CampgroundPost[]
  campgroundPostComments                          CampgroundPostComment[]
  campgroundPostLikes                             CampgroundPostLike[]
  campgroundReviews                               CampgroundReview[]
  checkIns                                        CheckIn[]
  comments                                        Comment[]
  commentReplies                                  CommentReply[]
  contentAnalytics                                ContentAnalytics[]
  contentShares                                   ContentShare[]
  creatorCollaborations                           CreatorCollaboration[]
  creatorContent                                  CreatorContent[]
  creatorComments                                 CreatorContentComment[]
  creatorLikes                                    CreatorContentLike[]
  taggedInContent                                 CreatorContentTag[]       @relation("TaggedInContent")
  creatorFollowers                                CreatorFollow[]           @relation("CreatorFollowers")
  followingCreators                               CreatorFollow[]           @relation("FollowingCreators")
  creatorInsight                                  CreatorInsight?
  creatorPageCollabs                              CreatorPageCollaborator[] @relation("CreatorPageCollaborator")
  creatorPageOwned                                CreatorPageCollaborator[] @relation("CreatorPageOwner")
  creatorReposts                                  CreatorRepost[]
  creatorSaves                                    CreatorSave[]
  creatorStats                                    CreatorStats?
  emailVerifications                              EmailVerification[]
  events                                          Event[]
  eventAttendees                                  EventAttendee[]
  eventBlocksCreated                              EventBlockedUser[]        @relation("EventBlocker")
  blockedFromEvents                               EventBlockedUser[]        @relation("BlockedFromEvents")
  eventComments                                   EventComment[]
  eventCommentMutes                               EventCommentMute[]
  assignedMeals                                   EventMeal[]               @relation("MealCook")
  friendshipsInitiated                            Friendship[]              @relation("FriendshipInitiator")
  friendshipsReceived                             Friendship[]              @relation("FriendshipReceiver")
  GearAdEvent                                     GearAdEvent[]
  gearItems                                       GearItem[]
  groups                                          Group[]
  groupInvitesReceived                            GroupInvite[]             @relation("GroupInvitee")
  groupInvitesSent                                GroupInvite[]             @relation("GroupInviter")
  groupMemberships                                GroupMember[]
  inventoryItems                                  InventoryItem[]
  likes                                           Like[]
  maintenanceRecords                              MaintenanceRecord[]
  maintenanceReminders                            MaintenanceReminder[]
  mealRSVPs                                       MealRSVP[]                @relation("MealRSVPs")
  Media                                           Media[]
  MediaComment                                    MediaComment[]
  MediaImpression                                 MediaImpression[]
  MediaReaction                                   MediaReaction[]
  MediaReport                                     MediaReport[]
  MediaTag_MediaTag_taggedByIdToUser              MediaTag[]                @relation("MediaTag_taggedByIdToUser")
  MediaTag_MediaTag_taggedUserIdToUser            MediaTag[]                @relation("MediaTag_taggedUserIdToUser")
  createdMentions                                 Mention[]                 @relation("CreatedMentions")
  mentions                                        Mention[]                 @relation("UserMentions")
  receivedMessages                                Message[]                 @relation("ReceivedMessages")
  sentMessages                                    Message[]                 @relation("SentMessages")
  mutedByUsers                                    MutedEntity[]             @relation("MutedByUsers")
  mutedEntities                                   MutedEntity[]             @relation("UserMutes")
  notifications                                   Notification[]
  packingListTemplates                            PackingListTemplate[]
  personalPackItems                               PersonalPackItem[]
  photos                                          Photo[]
  photoAlbums                                     PhotoAlbum[]
  campgroundPhotoTagsCreated                      PhotoCampgroundTag[]      @relation("CampgroundPhotoTagsCreated")
  photoComments                                   PhotoComment[]
  photoLikes                                      PhotoLike[]
  photoMoments                                    PhotoMoment[]
  photoReactions                                  PhotoReaction[]
  photoReports                                    PhotoReport[]             @relation("PhotoReporter")
  photoReviews                                    PhotoReport[]             @relation("PhotoReviewer")
  photoSaves                                      PhotoSave[]
  photoTagsCreated                                PhotoTag[]                @relation("PhotoTagsCreated")
  photoTagsReceived                               PhotoTag[]                @relation("PhotoTagsReceived")
  pinnedComments                                  PinnedComment[]
  posts                                           Post[]
  wallPosts                                       Post[]                    @relation("WallPosts")
  profileVisits                                   ProfileVisit[]            @relation("ProfileVisits")
  visitorVisits                                   ProfileVisit[]            @relation("VisitorVisits")
  rvShowcase                                      RVShowcase?
  reactions                                       Reaction[]
  recipes                                         Recipe[]
  recipeComments                                  RecipeComment[]
  recipeCommentLikes                              RecipeCommentLike[]
  recipeCommentMutes                              RecipeCommentMute[]
  recipeLikes                                     RecipeLike[]
  recipeRatings                                   RecipeRating[]
  savedRecipes                                    SavedRecipe[]
  savedTrips                                      SavedTrip[]
  tripComments                                    SavedTripComment[]
  stateVisits                                     StateVisit[]
  stateVisitAttendees                             StateVisitAttendee[]
  stays                                           Stay[]
  stickerRequests                                 StickerRequest[]
  tagBlockedUsers                                 TagBlockedUser[]          @relation("TagBlocked")
  tagBlockedBy                                    TagBlockedUser[]          @relation("TagBlocker")
  thingsCreated                                   ThingToDo[]               @relation("ThingsCreated")
  savedThings                                     ThingToDoSave[]           @relation("SavedThings")
  thingVotes                                      ThingToDoVote[]           @relation("ThingVotes")
  threads                                         Thread[]
  threadFavorites                                 ThreadFavorite[]
  threadIgnores                                   ThreadIgnore[]
  threadPosts                                     ThreadPost[]
  threadPostLikes                                 ThreadPostLike[]
  inTopFriendsOf                                  TopFriend[]               @relation("FriendInTopFriends")
  topFriends                                      TopFriend[]               @relation("UserTopFriends")
  trips                                           Trip[]
  assignedTripPackItems                           TripPackItem[]            @relation("AssignedTripPackItems")
  createdTripPackItems                            TripPackItem[]            @relation("CreatedTripPackItems")
  packedTripPackItems                             TripPackItem[]            @relation("PackedByTripPackItems")
  ridingWithTrips                                 TripPlan[]                @relation("RidingWith")
  tripPlans                                       TripPlan[]
  badges                                          UserBadge[]
  mileageLogs                                     UserMileageLog[]
  preferences                                     UserPreferences?
  userStickers                                    UserSticker[]
  videos                                          Video[]
  videoLikes                                      VideoLike[]
  videoWatches                                    VideoWatch[]

  @@index([email])
  @@index([username])
}

model Post {
  id             String          @id @default(cuid())
  content        String
  imageUrl       String?
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  wallOwnerId    String?
  groupId        String?
  comments       Comment[]
  likes          Like[]
  mentions       Mention[]
  pinnedComments PinnedComment[]
  group          Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallOwner      User?           @relation("WallPosts", fields: [wallOwnerId], references: [id], onDelete: Cascade)
  hashtags       PostHashtag[]
  reactions      Reaction[]

  @@index([userId])
  @@index([wallOwnerId])
  @@index([createdAt])
}

model Comment {
  id            String         @id @default(cuid())
  content       String
  postId        String
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  editHistory   Json?
  imageUrl      String?
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies       CommentReply[] @relation("CommentReplies")
  pinnedComment PinnedComment?
  reactions     Reaction[]

  @@index([postId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Friendship {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  status      String   @default("PENDING")
  initiatorId String
  receiverId  String
  updatedAt   DateTime @updatedAt
  initiator   User     @relation("FriendshipInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver    User     @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, receiverId])
  @@index([initiatorId])
  @@index([receiverId])
  @@index([status])
}

model Trip {
  id          String   @id @default(cuid())
  userId      String
  description String?
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  stays       Stay[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startDate])
}

model Campground {
  id                     String                   @id @default(cuid())
  name                   String
  description            String?
  location               String
  state                  String?
  latitude               Float?
  longitude              Float?
  amenities              String[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  campgroundMapUrl       String?
  accentColor            String?
  bookingUrl             String?
  businessEmail          String?
  businessPhone          String?
  claimedAt              DateTime?
  claimedById            String?
  customSlug             String?                  @unique
  facebookUrl            String?
  hashtag                String?                  @unique
  headerLayout           String?
  imageUrl               String?
  instagramUrl           String?
  theme                  String?
  tier                   CampgroundTier           @default(FREE)
  tierEndDate            DateTime?
  tierStartDate          DateTime?
  tiktokUrl              String?
  twitterUrl             String?
  verificationDocs       String[]                 @default([])
  verificationStatus     ClaimStatus              @default(UNCLAIMED)
  websiteUrl             String?
  youtubeUrl             String?
  campspotSlug           String?
  hasBackIn              Boolean?
  hasCableTV             Boolean?
  hasDumpStation         Boolean?
  hasElectricHookup      Boolean?
  hasFullHookups         Boolean?
  hasLaundry             Boolean?
  hasPool                Boolean?
  hasPropane             Boolean?
  hasPullThrough         Boolean?
  hasRestrooms           Boolean?
  hasSewerHookup         Boolean?
  hasShowers             Boolean?
  hasStore               Boolean?
  hasWaterHookup         Boolean?
  hasWifi                Boolean?
  isBigRigFriendly       Boolean?
  isPetFriendly          Boolean?
  isWaterfront           Boolean?
  maxAmpService          Int?
  maxRvLength            Int?
  pricePerNight          Float?
  seasonEnd              String?
  seasonStart            String?
  siteType               String?
  googlePlaceId          String?
  googleRating           Float?
  googleReviewCount      Int?
  phone                  String?
  activities             Activity[]               @relation("ActivityCampground")
  bookingClicks          BookingClick[]
  claimedBy              User?                    @relation("ClaimedCampgrounds", fields: [claimedById], references: [id])
  admins                 CampgroundAdmin[]
  analytics              CampgroundAnalytics[]
  announcements          CampgroundAnnouncement[]
  campgroundEvents       CampgroundEvent[]
  followers              CampgroundFollow[]
  wishlists              CampgroundWishlist[]
  photos                 CampgroundPhoto[]
  posts                  CampgroundPost[]
  reviews                CampgroundReview[]
  thingsToDo             CampgroundThingToDo[]
  checkIns               CheckIn[]
  creatorContent         CreatorContent[]
  taggedInCreatorContent CreatorContentTag[]      @relation("TaggedCampground")
  events                 Event[]
  mentions               Mention[]                @relation("CampgroundMentions")
  mutedBy                MutedEntity[]
  photoTags              PhotoCampgroundTag[]
  savedTrips             SavedTrip[]
  stateVisits            StateVisit[]
  stays                  Stay[]
  stickers               Sticker[]
  threads                Thread[]
  badges                 BadgeCampground[]


  @@index([state])
  @@index([name])
}

model Stay {
  id           String     @id @default(cuid())
  userId       String
  campgroundId String
  createdAt    DateTime   @default(now())
  endDate      DateTime
  notes        String?
  startDate    DateTime
  tripId       String?
  updatedAt    DateTime   @updatedAt
  campground   Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)
  trip         Trip?      @relation(fields: [tripId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
  @@index([campgroundId])
  @@index([startDate])
}

model Event {
  id                String               @id @default(cuid())
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime
  location          String?
  campgroundId      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organizerId       String
  isWishlist        Boolean              @default(false)
  groupId           String?
  tags              String[]             @default([])
  privacy           String               @default("PUBLIC")
  bannerImage       String?
  activities        Activity[]
  campground        Campground?          @relation(fields: [campgroundId], references: [id])
  group             Group?               @relation(fields: [groupId], references: [id])
  organizer         User                 @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  attendees         EventAttendee[]
  blockedUsers      EventBlockedUser[]
  comments          EventComment[]
  commentMutes      EventCommentMute[]
  meals             EventMeal[]
  subtabPrivacy     EventSubtabPrivacy[]
  mutedBy           MutedEntity[]
  personalPackItems PersonalPackItem[]
  photos            Photo[]
  savedTrips        SavedTrip[]
  stateVisits       StateVisit[]
  tripPackItems     TripPackItem[]       @relation("EventTripPackItems")
  tripPlans         TripPlan[]
  eventActivities   EventActivity[]

  @@index([organizerId])
  @@index([campgroundId])
  @@index([startDate])
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventMeal {
  id          String     @id @default(cuid())
  eventId     String
  mealType    String
  recipeId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  notes       String?
  scheduledAt DateTime
  scheduledTime String?
  cookId      String?
  cookStatus  String?    @default("PENDING")
  cook        User?      @relation("MealCook", fields: [cookId], references: [id])
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipe      Recipe?    @relation(fields: [recipeId], references: [id])
  rsvps       MealRSVP[]

  @@index([eventId])
  @@index([recipeId])
}

model MealRSVP {
  id        String    @id @default(cuid())
  mealId    String
  userId    String
  status    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  meal      EventMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  user      User      @relation("MealRSVPs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mealId, userId])
  @@index([mealId])
  @@index([userId])
}

model GearItem {
  id              String           @id @default(cuid())
  userId          String
  name            String
  category        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  description     String?
  imageUrl        String?
  groupId         String?
  lastUsedAt      DateTime?        @db.Timestamp(6)
  lastUsedEventId String?
  lastUsedTripId  String?
  purchaseDate    DateTime?        @db.Timestamp(6)
  purchasePrice   Decimal?         @db.Decimal(10, 2)
  brand           String?
  model           String?
  weight          Decimal?         @db.Decimal(10, 2)
  quantity        Int?             @default(1)
  condition       String?          @default("GOOD")
  notes           String?
  storageLocation String?
  storageNotes    String?
  AffiliateClick  AffiliateClick[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

model PhotoAlbum {
  id            String            @id @default(cuid())
  userId        String
  title         String
  description   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  privacy       String            @default("PUBLIC")
  coverPhotoUrl String?
  photos        Photo[]
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  albumComments PhotoComment[]
  stateVisits   StateVisitAlbum[]
  videos        Video[]           @relation("AlbumVideos")

  @@index([userId])
  @@index([privacy])
}

model Photo {
  id             String               @id @default(cuid())
  userId         String
  albumId        String?
  imageUrl       String
  caption        String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  eventId        String?
  visibility     String               @default("PUBLIC")
  moments        MomentPhoto[]
  album          PhotoAlbum?          @relation(fields: [albumId], references: [id])
  event          Event?               @relation(fields: [eventId], references: [id])
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  campgroundTags PhotoCampgroundTag[]
  photoComments  PhotoComment[]
  likes          PhotoLike[]
  reactions      PhotoReaction[]
  reports        PhotoReport[]
  saves          PhotoSave[]
  userTags       PhotoTag[]

  @@index([userId])
  @@index([albumId])
  @@index([eventId])
  @@index([visibility])
}

model StateVisit {
  id         String               @id @default(cuid())
  userId     String
  state      String
  createdAt  DateTime             @default(now())
  notes      String?
  updatedAt  DateTime             @updatedAt
  campsiteId String?
  endDate    DateTime?
  eventId    String?
  startDate  DateTime
  visibility String               @default("PUBLIC")
  campsite   Campground?          @relation(fields: [campsiteId], references: [id])
  event      Event?               @relation(fields: [eventId], references: [id])
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  albums     StateVisitAlbum[]
  attendees  StateVisitAttendee[]

  @@index([userId])
  @@index([state])
  @@index([startDate])
  @@index([campsiteId])
  @@index([eventId])
}

model StateVisitAlbum {
  id           String     @id @default(cuid())
  stateVisitId String
  albumId      String
  createdAt    DateTime   @default(now())
  album        PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  stateVisit   StateVisit @relation(fields: [stateVisitId], references: [id], onDelete: Cascade)

  @@unique([stateVisitId, albumId])
  @@index([stateVisitId])
  @@index([albumId])
}

model StateVisitAttendee {
  id           String     @id @default(cuid())
  stateVisitId String
  createdAt    DateTime   @default(now())
  attendeeId   String
  attendee     User       @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  stateVisit   StateVisit @relation(fields: [stateVisitId], references: [id], onDelete: Cascade)

  @@unique([stateVisitId, attendeeId])
  @@index([stateVisitId])
  @@index([attendeeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  content   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model MutedEntity {
  id                String      @id @default(cuid())
  userId            String
  mutedUserId       String?
  mutedCampgroundId String?
  createdAt         DateTime    @default(now())
  mutedActivityId   String?
  mutedEventId      String?
  snoozeDuration    String?
  snoozeUntil       DateTime?
  mutedCampground   Campground? @relation(fields: [mutedCampgroundId], references: [id], onDelete: Cascade)
  mutedEvent        Event?      @relation(fields: [mutedEventId], references: [id], onDelete: Cascade)
  mutedUser         User?       @relation("MutedByUsers", fields: [mutedUserId], references: [id], onDelete: Cascade)
  user              User        @relation("UserMutes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mutedUserId])
  @@unique([userId, mutedCampgroundId])
  @@unique([userId, mutedEventId])
  @@unique([userId, mutedActivityId])
  @@index([userId])
  @@index([mutedUserId])
  @@index([mutedCampgroundId])
  @@index([snoozeUntil])
}

model Recipe {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  ingredients        String[]
  prepTime           Int?
  cookTime           Int?
  servings           Int?
  imageUrl           String?
  userId             String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  difficulty         String?
  category           String?
  cuisine            String?
  instructions       String[]
  privacy            String              @default("PUBLIC")
  dietaryPreferences String[]            @default([])
  activities         Activity[]
  meals              EventMeal[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments           RecipeComment[]
  commentMutes       RecipeCommentMute[]
  likes              RecipeLike[]
  ratings            RecipeRating[]
  savedBy            SavedRecipe[]

  @@index([userId])
  @@index([category])
  @@index([cuisine])
  @@index([privacy])
}

model RecipeRating {
