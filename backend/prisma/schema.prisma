  grossWeight       Int?
  freshWaterGal     Int?
  grayWaterGal      Int?
  blackWaterGal     Int?
  fuelType          String?
  engineSize        String?
  chassisMake       String?
  tireSizeFront     String?
  tireSizeRear      String?
  tireInstallDate   DateTime?
  roofType          String?
  purchaseDate      DateTime?
  purchasePrice     Float?
  purchaseOdometer  Int?
  currentOdometer   Int?
  totalMilesDriven  Float?    @default(0)
  totalNightsCamped Int?      @default(0)
  totalTripCount    Int?      @default(0)
  totalStatesCount  Int?      @default(0)
  avgMPG            Float?
  totalFuelCost     Float?
  creatorBio        String?
  creatorBioHash    String?
  creatorBioAt      DateTime?
  youtubeUrl        String?
  instagramUrl      String?
  tiktokUrl         String?
  websiteUrl        String?
  followerCount                Int       @default(0)
  isCreatorEnabled             Boolean   @default(false)
  contributionScore            Float?    @default(0)
  contributionScoreUpdatedAt   DateTime?
  scoreBreakdown               Json?
  rigEmoji                     String?
  vibeTags                     String[]
  totalMiles                   Float     @default(0)
  totalNights                  Int       @default(0)
  statesVisited                String[]
  favoriteCampgroundId         String?
  isLiveNow                    Boolean   @default(false)
  lastLocationUpdate           DateTime?
  currentCampgroundId          String?
  onTheRoadEta                 DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  owner                        User      @relation("RigOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  pilots            RigPilot[]
  modLogs           ModLog[]
  fuelLogs          FuelLog[]
  documents         RigDocument[]
  followers         RigFollow[]
  posts             RigPost[]
  episodes          JourneyEpisode[]
  moments           RigMoment[]
  questions         RigQuestion[]
  suggestions       RigSuggestion[]
  polls             RigPoll[]
  guestMoments      RigGuestMoment[]
  followPreferences RigFollowPreference[]
  stops             RigStop[]
  routeSegments     RigRouteSegment[]
  momentBundles     RigMomentBundle[]
  activityItems     RigActivityItem[]
  insightCards      RigInsightCard[]
  activeTripId      String?
  rigTrips          RigTrip[]
  rigTripMilestones RigTripMilestone[]
}

model RigPilot {
  id        String   @id @default(cuid())
