  rigId         String
  title         String
  description   String?
  cost          Float?
  modDate       DateTime?
  photos        String[]
  category      String?
  beforePhoto   String?
  afterPhoto    String?
  productLink   String?
  isPublic      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  rig           Rig       @relation(fields: [rigId], references: [id], onDelete: Cascade)
}

model FuelLog {
  id            String    @id @default(cuid())
  rigId         String
  gallons       Float
  pricePerGal   Float
  totalCost     Float
  odometer      Int?
  location      String?
  loggedAt      DateTime  @default(now())
  rig           Rig       @relation(fields: [rigId], references: [id], onDelete: Cascade)
}

model RigDocument {
  id            String    @id @default(cuid())
  rigId         String
  name          String
  fileUrl       String
  expiresAt     DateTime?
  isPrivate     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  rig           Rig       @relation(fields: [rigId], references: [id], onDelete: Cascade)
}

model RigFollow {
  id                     String   @id @default(cuid())
  rigId                  String
  userId                 String
  followedAt             DateTime @default(now())
  sourceCreatorFollowId  String?
  notifyOnRigPost        Boolean  @default(true)
  notifyOnTrip           Boolean  @default(true)
  notifyOnMod            Boolean  @default(false)
  rig                    Rig      @relation(fields: [rigId], references: [id], onDelete: Cascade)
  user                   User     @relation("RigFollows", fields: [userId], references: [id], onDelete: Cascade)
