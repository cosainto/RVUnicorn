// Trip Planning for Events
model TripPlan {
  id                String    @id @default(cuid())
  eventId           String
  userId            String
  pitStops          PitStop[]
  packItems         PersonalPackItem[]  
  tripPackItems     TripPackItem[] @relation("TripPackItems")

  
  // Starting location (defaults to user's hometown, can be overridden)
  startLocation     String    // "City, State" or full address
  startLatitude     Float?
  startLongitude    Float?
  useHometown       Boolean   @default(true)
  
  // Destination (from event's campground)
  endLocation       String
  endLatitude       Float?
  endLongitude      Float?
  
  // Calculated route info
  distanceMiles     Float?
  durationMinutes   Int?
  routePolyline     String?   // Encoded polyline for map display
  
  // Trip status
  status            String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  completedAt       DateTime?
  actualMiles       Float?    // User can log actual miles after trip
  
  // Driving arrangement
  isDriving         Boolean   @default(true)
  ridingWithId      String?   // If riding with another user
  
  // Preferences
  routePreference   String    @default("FASTEST") // FASTEST, SHORTEST, RV_FRIENDLY
  avoidTolls        Boolean   @default(false)
  avoidHighways     Boolean   @default(false)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ridingWith        User?     @relation("RidingWith", fields: [ridingWithId], references: [id])
  mileageLogs       UserMileageLog[]
  
  @@unique([eventId, userId])
}

// User's total mileage tracking
model UserMileageLog {
  id            String   @id @default(cuid())
  userId        String
