model Mention {
  id            String    @id @default(cuid())
  
  // What contains the mention
  postId        String?
  post          Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  activityId    String?
  activity      Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  
  // Who/what was mentioned
  mentionedUserId      String?
  mentionedUser        User?       @relation("UserMentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  
  mentionedCampgroundId String?
  mentionedCampground   Campground? @relation("CampgroundMentions", fields: [mentionedCampgroundId], references: [id], onDelete: Cascade)
  
  // Who created the mention
  createdById   String
  createdBy     User      @relation("CreatedMentions", fields: [createdById], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  
  @@index([mentionedUserId])
  @@index([mentionedCampgroundId])
  @@index([postId])
  @@index([activityId])
}
