// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampgroundTier {
  FREE
  CLASS_C
  CLASS_B
  CLASS_A
}

enum ClaimStatus {
  UNCLAIMED
  PENDING
  VERIFIED
  REJECTED
}

enum AdminRole {
  OWNER
  ADMIN
  MODERATOR
}

enum AnnouncementPriority {
  LOW
  NORMAL
  IMPORTANT
  URGENT
}




model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  username        String    @unique
  firstName       String
  lastName        String
  profilePicture  String?
  coverPhoto      String?
  bio             String?
  location        String?
  website         String?
  facebookUrl     String?
  instagramUrl    String?
  tiktokUrl       String?
  redditUrl       String?
  youtubeUrl      String?
  twitterUrl      String?
  blueskyUrl      String?
  showSocialOnProfile    Boolean @default(true)
  showSocialOnCreator    Boolean @default(true)
  rvType          String?
  rvYear          Int?
  rvMake          String?
  rvModel         String?
  rvLength        Int?
  rvWidth         Int?
  rvHeight        Int?
  licensePlate    String?
  licensePlateState String?
  tagExpiration   DateTime?
  rvOdometer      Int?        // Current odometer reading
  rvSleeps        Int?
  rvSlideouts     Int?
  rvWeight        Int?
  rvDescription   String?
  rvFeatures      String[]
  
  // Home location for trip planning
  homeAddress     String?
  homeCity        String?
  homeState       String?
  homeZipCode     String?
  homeCountry     String?   @default("USA")
  homeLatitude    Float?
  homeLongitude   Float?
  
  // Travel preferences
  travelPartyType   String?   // SOLO, COUPLE, FAMILY, GROUP
  travelPartySize   Int?
  hasPets           Boolean   @default(false)
  petTypes          String[]  @default([])
  preferredTripLength String? // WEEKEND, WEEK, EXTENDED, FULLTIME
  
  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)
  
  status          String?
  statusEmoji     String?
  statusType      String?
  currentCampsite String?
  showCampingStatus Boolean @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tripPlans         TripPlan[]
  ridingWithTrips   TripPlan[]       @relation("RidingWith")
  mileageLogs       UserMileageLog[]
  bookingClicks     BookingClick[]

  posts                Post[]
  comments             Comment[]
  likes                Like[]
  trips                Trip[]
  stays                Stay[]
  events               Event[]
  attractions          Attraction[]
  topFriends           TopFriend[] @relation("UserTopFriends")
  inTopFriendsOf       TopFriend[] @relation("FriendInTopFriends")
  eventAttendees       EventAttendee[]
  eventComments        EventComment[]
  gearItems            GearItem[]
  stateVisits          StateVisit[]
  stateVisitAttendees  StateVisitAttendee[]
  notifications        Notification[]
  friendshipsInitiated Friendship[] @relation("FriendshipInitiator")
  friendshipsReceived  Friendship[] @relation("FriendshipReceiver")
  recipes              Recipe[]
  recipeRatings        RecipeRating[]
  recipeComments       RecipeComment[]
  savedRecipes         SavedRecipe[]
  photoAlbums          PhotoAlbum[]
  photos               Photo[]
  checkIns             CheckIn[]
  userStickers         UserSticker[]
  stickerRequests      StickerRequest[]
  campgroundFollows    CampgroundFollow[]  
  campgroundAdmins       CampgroundAdmin[]
  campgroundPosts        CampgroundPost[]
  campgroundPostLikes    CampgroundPostLike[]
  campgroundPostComments CampgroundPostComment[]  
  campgroundReviews      CampgroundReview[]
  campgroundPhotos       CampgroundPhoto[]
  reviewedPhotos         CampgroundPhoto[]    @relation("PhotoReviewer")
  campgroundEvents       CampgroundEvent[]
  campgroundAnnouncements CampgroundAnnouncement[]
  threads                Thread[]
  threadPosts            ThreadPost[]
  threadPostLikes        ThreadPostLike[]
  activityLikes          ActivityLike[]
  recipeLikes            RecipeLike[]
  recipeCommentLikes     RecipeCommentLike[]
  threadFavorites        ThreadFavorite[]
  threadIgnores          ThreadIgnore[]
  activities             Activity[]
  activityTargets        Activity[] @relation("ActivityTarget")
  activitySecondary      Activity[] @relation("ActivitySecondaryUser")
  wallPosts              Post[] @relation("WallPosts")  
  inventoryItems              InventoryItem[]
  assignedTripPackItems       TripPackItem[]     @relation("AssignedTripPackItems")
  packedTripPackItems         TripPackItem[]     @relation("PackedByTripPackItems")
  createdTripPackItems        TripPackItem[]     @relation("CreatedTripPackItems")
  packingListTemplates        PackingListTemplate[]
  basecampActivitiesReceived  BasecampActivity[] @relation("BasecampActivityRecipient")
  basecampActivitiesPerformed BasecampActivity[] @relation("BasecampActivityActor")
  personalPackItems      PersonalPackItem[]
  preferences            UserPreferences?
  maintenanceRecords     MaintenanceRecord[]
  maintenanceReminders   MaintenanceReminder[]
  rvShowcase             RVShowcase?
  groups                 Group[]
  groupMemberships       GroupMember[]
  groupInvitesSent       GroupInvite[] @relation("GroupInviter")
  groupInvitesReceived   GroupInvite[] @relation("GroupInvitee")
  mentions               Mention[] @relation("UserMentions")
  createdMentions        Mention[] @relation("CreatedMentions")
  savedTrips             SavedTrip[]
  tripComments           SavedTripComment[]  

  claimedCampgrounds     Campground[]      @relation("ClaimedCampgrounds")
  mutedEntities          MutedEntity[]     @relation("UserMutes")
  mutedByUsers           MutedEntity[]     @relation("MutedByUsers")
  
  photoTagsReceived      PhotoTag[]        @relation("PhotoTagsReceived")
  photoTagsCreated       PhotoTag[]        @relation("PhotoTagsCreated")
  campgroundPhotoTagsCreated PhotoCampgroundTag[] @relation("CampgroundPhotoTagsCreated")
  
  // Social enhancements
  reactions              Reaction[]
  commentReplies         CommentReply[]
  pinnedComments         PinnedComment[]

  // Privacy & Security
  lastActiveAt         DateTime?
  blockedUsers         BlockedUser[] @relation("UserBlocks")
  blockedByUsers       BlockedUser[] @relation("BlockedByUsers")
  activityLogs         AccountActivityLog[]
  accountDeletion      AccountDeletion?
  emailVerifications   EmailVerification[]

// Creator Page Settings
  isCreator         Boolean   @default(false)
  creatorEnabledAt  DateTime?
  creatorBio        String?
  creatorDisplayName String?
  creatorHandle     String?
  creatorSpecialties String[]
  creatorCoverImage String?
  creatorVerified   Boolean   @default(false)
  creatorFeatured   Boolean   @default(false)
  
  // Creator Relations
  creatorContent       CreatorContent[]
  creatorFollowers     CreatorFollow[]   @relation("CreatorFollowers")
  followingCreators    CreatorFollow[]   @relation("FollowingCreators")
  creatorLikes         CreatorContentLike[]
  creatorComments      CreatorContentComment[]
  creatorReposts       CreatorRepost[]
  creatorSaves         CreatorSave[]
  creatorCollaborations CreatorCollaboration[]
  creatorStats         CreatorStats?
  taggedInContent      CreatorContentTag[] @relation("TaggedInContent")
  creatorPageOwned     CreatorPageCollaborator[] @relation("CreatorPageOwner")
  creatorPageCollabs   CreatorPageCollaborator[] @relation("CreatorPageCollaborator")


// Badges for users

  badges            UserBadge[]
  assignedMeals     EventMeal[]   @relation("MealCook")
  mealRSVPs         MealRSVP[]    @relation("MealRSVPs")
  recipeCommentMutes RecipeCommentMute[]
  eventCommentMutes  EventCommentMute[]
  blockedFromEvents  EventBlockedUser[] @relation("BlockedFromEvents")
  eventBlocksCreated EventBlockedUser[] @relation("EventBlocker")

  @@index([email])
  @@index([username])
}

model Post {
  id          String   @id @default(cuid())
  userId      String
  wallOwnerId String?  // NEW: whose wall this post is on (null = own wall)
  content     String
  imageUrl    String?
  groupId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallOwner      User?           @relation("WallPosts", fields: [wallOwnerId], references: [id], onDelete: Cascade)
  group          Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  comments       Comment[]
  likes          Like[]
  mentions       Mention[]
  reactions      Reaction[]
  hashtags       PostHashtag[]
  pinnedComments PinnedComment[]
  
  @@index([userId])
  @@index([wallOwnerId])

  @@index([createdAt])
}


model Comment {
  id          String   @id @default(cuid())
  postId      String
  userId      String
  content     String
  imageUrl    String?  // For rich media comments
  editHistory Json?    // Array of {content, editedAt}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post          Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions     Reaction[]
  replies       CommentReply[]  @relation("CommentReplies")
  pinnedComment PinnedComment?

  @@index([postId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Friendship {
  id          String   @id @default(cuid())
  initiatorId String
  receiverId  String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  initiator User @relation("FriendshipInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver  User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([initiatorId, receiverId])
  @@index([initiatorId])
  @@index([receiverId])
  @@index([status])
}

model Trip {
  id          String    @id @default(cuid())
  userId      String
  name        String
  startDate   DateTime
  endDate     DateTime
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  stays Stay[]

  @@index([userId])
  @@index([startDate])
}

model Campground {
  id          String   @id @default(cuid())
  name        String
  location    String
  state       String?
  description String?
  latitude    Float?
  longitude   Float?
  amenities   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campgroundMapUrl String?  
  bookingClicks BookingClick[]  


  // === Business Tier System ===
  tier              CampgroundTier @default(FREE)
  tierStartDate     DateTime?
  tierEndDate       DateTime?

  // === Claim & Ownership ===
  claimedAt         DateTime?
  claimedById       String?
  claimedBy         User?          @relation("ClaimedCampgrounds", fields: [claimedById], references: [id])
  verificationStatus ClaimStatus   @default(UNCLAIMED)
  verificationDocs  String[]       @default([])

  // === Branding (Class B+) ===
  imageUrl          String?
  accentColor       String?
  headerLayout      String?
  theme             String?
  customSlug        String?        @unique

  // === Business Info ===
  hashtag           String?        @unique
  businessEmail     String?
  businessPhone     String?
  bookingUrl        String?
  campspotSlug      String?        // Campspot.com integration
  websiteUrl        String?
  
  // === Social Links ===
  facebookUrl       String?
  instagramUrl      String?
  twitterUrl        String?
  youtubeUrl        String?
  tiktokUrl         String?

  stays       Stay[]
  events      Event[]
  stateVisits StateVisit[]
  checkIns    CheckIn[]
  stickers    Sticker[]
  followers   CampgroundFollow[]  
  admins      CampgroundAdmin[]
  posts       CampgroundPost[]
  reviews     CampgroundReview[]
  photos      CampgroundPhoto[]
  campgroundEvents  CampgroundEvent[]
  announcements  CampgroundAnnouncement[]  
  threads           Thread[]
  activities        Activity[] @relation("ActivityCampground")
  mentions    Mention[] @relation("CampgroundMentions")
  savedTrips  SavedTrip[]
  analytics   CampgroundAnalytics[]
  mutedBy     MutedEntity[]
  photoTags   PhotoCampgroundTag[]
  creatorContent    CreatorContent[]
  taggedInCreatorContent   CreatorContentTag[] @relation("TaggedCampground")

  @@index([state])
  @@index([name])
}

model Stay {
  id           String    @id @default(cuid())
  userId       String
  tripId       String?
  campgroundId String
  startDate    DateTime
  endDate      DateTime
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip       Trip?      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  campground Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tripId])
  @@index([campgroundId])
  @@index([startDate])
}

model Event {
  id           String    @id @default(cuid())
  organizerId  String
  campgroundId String?
  groupId      String?
  title        String
  description  String?
  bannerImage  String?
  startDate    DateTime
  endDate      DateTime
  location     String?
  tags         String[]  @default([])
  isWishlist  Boolean  @default(false)
  privacy     String   @default("PUBLIC")  // PUBLIC, FRIENDS, PRIVATE
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizer   User            @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  campground  Campground?     @relation(fields: [campgroundId], references: [id], onDelete: SetNull)
  group       Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  attendees   EventAttendee[]
  meals       EventMeal[]
  stateVisits StateVisit[]
  tripPlans   TripPlan[]  
  activities  Activity[]
  personalPackItems PersonalPackItem[]
  photos      Photo[]
  comments    EventComment[]
  savedTrips  SavedTrip[]  
  tripPackItems TripPackItem[] @relation("EventTripPackItems")
  mutedBy          MutedEntity[]
  commentMutes     EventCommentMute[]
  blockedUsers     EventBlockedUser[]
  subtabPrivacy    EventSubtabPrivacy[]



  @@index([organizerId])
  @@index([campgroundId])
  @@index([startDate])
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventMeal {
  id          String   @id @default(cuid())
  eventId     String
  recipeId    String?
  mealType    String
  scheduledAt DateTime
  notes       String?
  cookId      String?
  cookStatus  String?   @default("PENDING")  // PENDING, ACCEPTED, DECLINED, UNDECIDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  cook   User?   @relation("MealCook", fields: [cookId], references: [id], onDelete: SetNull)
  rsvps  MealRSVP[]

  @@index([eventId])
  @@index([recipeId])
}

model MealRSVP {
  id        String   @id @default(cuid())
  mealId    String
  userId    String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meal EventMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  user User      @relation("MealRSVPs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mealId, userId])
  @@index([mealId])
  @@index([userId])
}

model GearItem {
  id          String   @id @default(cuid())
  userId      String
  name        String
  category    String
  description String?
  imageUrl    String?
  groupId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
}

model PhotoAlbum {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  privacy     String   @default("PUBLIC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      Photo[]
  stateVisits StateVisitAlbum[]

  @@index([userId])
  @@index([privacy])
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  albumId   String?
  eventId   String?
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  album PhotoAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)
  event Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  
  userTags       PhotoTag[]
  campgroundTags PhotoCampgroundTag[]

  @@index([userId])
  @@index([albumId])
  @@index([eventId])
}



model StateVisit {
  id         String    @id @default(cuid())
  userId     String
  state      String
  startDate  DateTime
  endDate    DateTime?
  notes      String?
  campsiteId String?
  eventId    String?
  visibility String   @default("PUBLIC")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  campsite  Campground?          @relation(fields: [campsiteId], references: [id])
  event     Event?               @relation(fields: [eventId], references: [id])
  attendees StateVisitAttendee[]
  albums    StateVisitAlbum[]

  @@index([userId])
  @@index([state])
  @@index([startDate])
  @@index([campsiteId])
  @@index([eventId])
}

model StateVisitAlbum {
  id           String   @id @default(cuid())
  stateVisitId String
  albumId      String
  createdAt    DateTime @default(now())

  stateVisit StateVisit @relation(fields: [stateVisitId], references: [id], onDelete: Cascade)
  album      PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([stateVisitId, albumId])
  @@index([stateVisitId])
  @@index([albumId])
}

model StateVisitAttendee {
  id           String   @id @default(cuid())
  stateVisitId String
  attendeeId   String
  createdAt    DateTime @default(now())

  stateVisit StateVisit @relation(fields: [stateVisitId], references: [id], onDelete: Cascade)
  attendee   User       @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([stateVisitId, attendeeId])
  @@index([stateVisitId])
  @@index([attendeeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  content   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])

  @@index([createdAt])
}

model MutedEntity {
  id                String      @id @default(cuid())
  userId            String
  mutedUserId       String?
  mutedCampgroundId String?
  mutedEventId      String?     // NEW: mute specific events
  mutedActivityId   String?     // NEW: dismiss specific activities
  
  // Snooze duration
  snoozeDuration    String?     // "7_DAYS", "30_DAYS", "120_DAYS", "FOREVER"
  snoozeUntil       DateTime?   // When snooze expires (null = forever)
  
  createdAt         DateTime    @default(now())
  
  user              User        @relation("UserMutes", fields: [userId], references: [id], onDelete: Cascade)
  mutedUser         User?       @relation("MutedByUsers", fields: [mutedUserId], references: [id], onDelete: Cascade)
  mutedCampground   Campground? @relation(fields: [mutedCampgroundId], references: [id], onDelete: Cascade)
  mutedEvent        Event?      @relation(fields: [mutedEventId], references: [id], onDelete: Cascade)
  
  @@unique([userId, mutedUserId])
  @@unique([userId, mutedCampgroundId])
  @@unique([userId, mutedEventId])
  @@unique([userId, mutedActivityId])
  @@index([userId])
  @@index([mutedUserId])
  @@index([mutedCampgroundId])
  @@index([snoozeUntil])
}

// DELETE the old model below this line
model Recipe {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  ingredients  String[]
  instructions String[]
  prepTime     Int?
  cookTime     Int?
  servings     Int?
  difficulty   String?
  cuisine      String?
  category     String?
  dietaryPreferences String[] @default([])
  privacy      String   @default("PUBLIC")
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings  RecipeRating[]
  meals    EventMeal[]
  comments RecipeComment[]
  savedBy  SavedRecipe[]
  activities Activity[]
  likes      RecipeLike[]
  commentMutes RecipeCommentMute[]

  @@index([userId])
  @@index([category])
  @@index([cuisine])
  @@index([privacy])
}

model RecipeRating {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  rating    Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@index([recipeId])
  @@index([userId])
}

model RecipeComment {
  id        String   @id @default(cuid())
  recipeId  String
  userId    String
  content   String
  imageUrl  String?
  mentions  String[] @default([])
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe  Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes   RecipeCommentLike[]
  parent  RecipeComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies RecipeComment[] @relation("CommentReplies")

  @@index([recipeId])
  @@index([userId])
  @@index([parentId])
}

model SavedRecipe {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
}

model CheckIn {
  id           String    @id @default(cuid())
  userId       String
  campgroundId String
  checkInDate  DateTime
  checkOutDate DateTime?
  siteNumber   String?
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campground Campground @relation(fields: [campgroundId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([campgroundId])
  @@index([isActive])
}

model Sticker {
  id           String   @id @default(cuid())
  campgroundId String
  name         String
  description  String?
  imageUrl     String?
  emoji        String?
  criteria     String?
  isLimited    Boolean  @default(false)
  maxQuantity  Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campground      Campground       @relation(fields: [campgroundId], references: [id], onDelete: Cascade)
  userStickers    UserSticker[]
  stickerRequests StickerRequest[]

  @@index([campgroundId])
}

model UserSticker {
  id        String   @id @default(cuid())
  userId    String
  stickerId String
  earnedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sticker Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)

  @@unique([userId, stickerId])
  @@index([userId])
  @@index([stickerId])
}

model StickerRequest {
  id        String   @id @default(cuid())
  userId    String
  stickerId String
  evidence  String?
