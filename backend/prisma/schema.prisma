  checkIn         CheckIn   @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  inviter         User      @relation("CheckInInviteSent", fields: [inviterId], references: [id])
  invitee         User      @relation("CheckInInviteReceived", fields: [inviteeId], references: [id])

  @@unique([checkInId, inviteeId])
  @@index([inviteeId, status])
  @@index([status, expiresAt])
}

// ═══ Nearby Experiences & Community Reviews ═══

model NearbyExperience {
  id                  String               @id @default(cuid())
  placeId             String?              @unique // Google Places ID or internal
  name                String
  address             String?
  category            String               @default("OTHER") // TRAIL, RESTAURANT, ATTRACTION, MUSEUM, MARKET, SCENIC_VIEW, FISHING_SPOT, PLAYGROUND, OTHER
  description         String?
  website             String?
  latitude            Float?
  longitude           Float?
  photoUrls           String[]
  addedByUserId       String?
  isVerified          Boolean              @default(false)
  isModerationPending Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  addedBy             User?                @relation("ExperienceAddedBy", fields: [addedByUserId], references: [id])
  reviews             ExperienceReview[]
  questions           ExperienceQuestion[]
  visits              ExperienceVisit[]

  @@index([latitude, longitude])
  @@index([category])
  @@index([isModerationPending])
}

model ExperienceReview {
  id                   String                @id @default(cuid())
  experienceId         String
  userId               String
  starRating           Int                   // 1-5
  recommendation       String                // LOVED_IT | WORTH_VISITING | JUST_OKAY | WOULD_SKIP
  body                 String?
  photoUrls            String[]
  bestTimeToVisit      String?
  familyFriendlyRating Int?                  // 1-5
  petFriendlyRating    Int?                  // 1-5
  accessibilityNotes   String?
  helpfulCount         Int                   @default(0)
  notHelpfulCount      Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  experience           NearbyExperience      @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes                ExperienceReviewVote[]

  @@unique([experienceId, userId])
  @@index([experienceId])
  @@index([userId])
}

model ExperienceReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  vote      String   // HELPFUL | NOT_HELPFUL
  createdAt DateTime @default(now())

  review    ExperienceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

model ExperienceQuestion {
  id           String             @id @default(cuid())
  experienceId String
  userId       String
  question     String
  createdAt    DateTime           @default(now())

  experience   NearbyExperience   @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      ExperienceAnswer[]

  @@index([experienceId])
}

model ExperienceAnswer {
  id            String             @id @default(cuid())
  questionId    String
  userId        String
  answer        String
  helpfulCount  Int                @default(0)
  isHighlighted Boolean            @default(false)
  createdAt     DateTime           @default(now())

  question      ExperienceQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model ExperienceVisit {
  id           String           @id @default(cuid())
  experienceId String
  userId       String
  visitedAt    DateTime         @default(now())
  createdAt    DateTime         @default(now())

  experience   NearbyExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([experienceId, userId])
  @@index([experienceId])
  @@index([userId])
}

// ═══ Campfire Chat Modes ═══

model CampfireGroup {
  id              String                @id @default(cuid())
  campgroundId    String
  name            String?
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  createdBy       User                  @relation("CampfireGroupCreator", fields: [createdByUserId], references: [id])
  members         CampfireGroupMember[]
  messages        CampfireGroupMessage[]

  @@index([campgroundId])
  @@index([createdByUserId])
}

model CampfireGroupMember {
  id       String        @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime      @default(now())

  group    CampfireGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model CampfireGroupMessage {
  id        String        @id @default(cuid())
  groupId   String
  userId    String
  content   String
  createdAt DateTime      @default(now())

  group     CampfireGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model AICampfireSession {
  id           String   @id @default(cuid())
  userId       String
  campgroundId String
  characterId  String
  messages     Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, campgroundId])
}

// ═══ Rig Journey System ═══

model JourneyEpisode {
  id             String    @id @default(cuid())
  rigId          String
  title          String
  subtitle       String?
  startDate      DateTime
  endDate        DateTime?
  startLocation  String?
  endLocation    String?
  coverImageUrl  String?
  episodeType    String    @default("STAY") // TRAVEL | STAY | INCIDENT | DISCOVERY | OTHER
  order          Int       @default(0)
  autoGenerated  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rig            Rig       @relation(fields: [rigId], references: [id], onDelete: Cascade)
  posts          RigPost[]
  moments        RigMoment[]

  @@index([rigId, order])
}

model RigMoment {
  id             String          @id @default(cuid())
  rigId          String
  userId         String
  episodeId      String?
  momentType     String          @default("SCENIC") // ARRIVAL | SCENIC | WILDLIFE | BREAKDOWN | UNEXPECTED | CAMPSITE | MILESTONE | WEATHER
  title          String
  body           String?
  photoUrls      String[]
  lat            Float?
  lng            Float?
  campgroundId   String?
  isFeatured     Boolean         @default(false)
  featuredReason String?
  createdAt      DateTime        @default(now())

  rig            Rig             @relation(fields: [rigId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode        JourneyEpisode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([rigId, createdAt])
  @@index([rigId, isFeatured])
}

model RigQuestion {
  id         String    @id @default(cuid())
  rigId      String
  askerId    String
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  rig        Rig       @relation(fields: [rigId], references: [id], onDelete: Cascade)
  asker      User      @relation("RigQuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)

  @@index([rigId])
}

model RigSuggestion {
  id           String   @id @default(cuid())
  rigId        String
  suggesterId  String
  type         String   @default("NEXT_STOP") // NEXT_STOP | CAMPGROUND_REC | TIP
  content      String
  campgroundId String?
  upvotes      Int      @default(0)
  createdAt    DateTime @default(now())

  rig          Rig      @relation(fields: [rigId], references: [id], onDelete: Cascade)
  suggester    User     @relation(fields: [suggesterId], references: [id], onDelete: Cascade)

  @@index([rigId, upvotes])
}

model RigPoll {
  id        String    @id @default(cuid())
  rigId     String
  creatorId String
  question  String
  options   Json      // ["Option A", "Option B", ...]
  votes     Json      @default("{}") // { "userId": "optionIndex", ... }
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  rig       Rig       @relation(fields: [rigId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([rigId])
}

model RigGuestMoment {
  id        String   @id @default(cuid())
  rigId     String
  authorId  String
  content   String
  photoUrls String[]
  metAt     String?
  siteNumber String?
  createdAt DateTime @default(now())

  rig       Rig      @relation(fields: [rigId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([rigId])
}

model RigFollowPreference {
  id        String   @id @default(cuid())
  rigId     String
  userId    String
  mode      String   @default("FULL") // FULL | LOCATION_ONLY | WEEKLY_DIGEST | HIGHLIGHTS_ONLY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rig       Rig      @relation(fields: [rigId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rigId, userId])
}

// ═══ Rig Feed v2 — Stops, Routes, Bundles ═══

model RigStop {
