import { useState, useEffect } from 'react';
import { useParams, Link, useNavigate } from 'react-router-dom';
import { MapPin, Star, Phone, Globe, Mail, Calendar, Users, ChevronLeft } from 'lucide-react';
import api from '../services/api';

interface Campground {
  id: string;
  name: string;
  slug: string;
  description: string;
  address: string;
  city: string;
  state: string;
  zipCode: string;
  phone?: string;
  website?: string;
  email?: string;
  amenities: string[];
  averageRating?: number;
  totalReviews: number;
  totalStays: number;
  images: string[];
  coverImage?: string;
  isVerified: boolean;
}

interface Review {
  id: string;
  rating: number;
  review?: string;
  checkIn: string;
  checkOut: string;
  user: {
    id: string;
    firstName: string;
    lastName: string;
    username: string;
    profilePicture?: string;
  };
}

const AMENITY_LABELS: { [key: string]: string } = {
  WIFI: '📶 WiFi',
  WATER: '💧 Water Hookup',
  ELECTRIC: '⚡ Electric',
  SEWER: '🚰 Sewer',
  PETS: '🐕 Pet Friendly',
  POOL: '🏊 Pool',
  SHOWERS: '🚿 Showers',
  LAUNDRY: '🧺 Laundry',
};

export default function CampgroundDetailPage() {
  const { slug } = useParams<{ slug: string }>();
  const navigate = useNavigate();
  const [campground, setCampground] = useState<Campground | null>(null);
  const [reviews, setReviews] = useState<Review[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const loadCampground = async () => {
      try {
        setLoading(true);
        const { data } = await api.get(`/campgrounds/${slug}`);
        setCampground(data);
        
        // Load reviews
        const reviewsResponse = await api.get(`/campgrounds/${data.id}/reviews`);
        setReviews(reviewsResponse.data);
      } catch (error) {
        console.error('Failed to load campground:', error);
      } finally {
        setLoading(false);
      }
    };

    if (slug) {
      loadCampground();
    }
  }, [slug]);

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600 mx-auto mb-4"></div>
          <p className="text-gray-600">Loading campground...</p>
        </div>
      </div>
    );
  }

  if (!campground) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="text-center">
          <p className="text-gray-600">Campground not found</p>
          <button onClick={() => navigate('/campgrounds')} className="btn btn-primary mt-4">
            Back to Campgrounds
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="max-w-7xl mx-auto px-4 py-8">
      <button
        onClick={() => navigate('/campgrounds')}
        className="flex items-center text-gray-600 hover:text-gray-900 mb-6"
      >
        <ChevronLeft className="w-5 h-5" />
        <span>Back to Campgrounds</span>
      </button>

      <div className="bg-white rounded-lg shadow-lg overflow-hidden mb-8">
        <div className="h-96 bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center">
          <MapPin className="w-32 h-32 text-white opacity-50" />
        </div>
      
        <div className="p-8">
          <div className="flex items-start justify-between mb-4">
            <div className="flex-1">
              <h1 className="text-4xl font-bold text-gray-900 mb-2">{campground.name}</h1>
              <div className="flex items-center text-gray-600 text-lg mb-4">
                <MapPin className="w-5 h-5 mr-2" />
                <span>{campground.city}, {campground.state} {campground.zipCode}</span>
              </div>
            </div>
      
            <div className="flex gap-3">
              <Link 
                to={`/campgrounds/${campground.slug}/business`}
                className="btn btn-secondary flex items-center space-x-2"
              >
                <Users className="w-5 h-5" />
                <span>Business Page</span>
              </Link>
              <button onClick={() => navigate('/events')} className="btn btn-primary flex items-center space-x-2">
                <Calendar className="w-5 h-5" />
                <span>Plan Trip Here</span>
              </button>
            </div>
          </div>
      
          {campground.averageRating && (   
            <div className="flex items-center space-x-4 mb-6">
              <div className="flex items-center">
                <Star className="w-6 h-6 text-yellow-400 fill-current" />
                <span className="text-2xl font-bold ml-2">{campground.averageRating.toFixed(1)}</span>
              </div>
              <span className="text-gray-600">({campground.totalReviews} reviews)</span>
              <span className="text-gray-400">•</span>
              <span className="text-gray-600">{campground.totalStays} stays</span>
            </div>
          )}
            
          <p className="text-gray-700 text-lg mb-6 leading-relaxed">{campground.description}</p>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            {campground.phone && (
              
                href={`tel:${campground.phone}`}
                className="flex items-center text-gray-700 hover:text-primary-600 transition"
              >
                <Phone className="w-5 h-5 mr-3" />
                <span>{campground.phone}</span>
              </a>
            )}
            {campground.website && (
              
                href={campground.website}
                target="_blank"
                rel="noopener noreferrer"
                className="flex items-center text-gray-700 hover:text-primary-600 transition"
              >
                <Globe className="w-5 h-5 mr-3" />
                <span>Visit Website</span>
              </a>
            )}
            {campground.email && (
              
                href={`mailto:${campground.email}`}
                className="flex items-center text-gray-700 hover:text-primary-600 transition"
              >
                <Mail className="w-5 h-5 mr-3" />
                <span>{campground.email}</span>
              </a>
            )}
          </div>

          <div>
            <h2 className="text-2xl font-bold text-gray-900 mb-4">Amenities</h2>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
              {campground.amenities.map((amenity) => (
                <div
                  key={amenity}
                  className="flex items-center space-x-2 bg-gray-50 rounded-lg p-3"
                >
                  <span className="text-2xl">{AMENITY_LABELS[amenity]?.split(' ')[0] || '✓'}</span>
                  <span className="text-gray-700">{AMENITY_LABELS[amenity]?.substring(2) || amenity}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div className="bg-white rounded-lg shadow-lg p-8">
        <h2 className="text-2xl font-bold text-gray-900 mb-6">Reviews</h2>
        {reviews.length > 0 ? (
          <div className="space-y-6">
            {reviews.map((review) => (
              <div key={review.id} className="border-b border-gray-200 pb-6 last:border-0">
                <div className="flex items-start space-x-4">
                  {review.user.profilePicture ? (
                    <img
                      src={`http://127.0.0.1:3001${review.user.profilePicture}`}
                      alt={review.user.firstName}
                      className="w-12 h-12 rounded-full"
                    />
                  ) : (
                    <div className="w-12 h-12 rounded-full bg-primary-200 flex items-center justify-center">
                      <span className="text-primary-600 font-bold text-lg">
                        {review.user.firstName[0]}
                      </span>
                    </div>
                  )}
                  
                  <div className="flex-1">
                    <div className="flex items-center justify-between mb-2">
                      <div>
                        <p className="font-semibold text-gray-900">
                          {review.user.firstName} {review.user.lastName}
                        </p>
                        <p className="text-sm text-gray-600">@{review.user.username}</p>
                      </div>
                      <div className="flex items-center">
                        <Star className="w-5 h-5 text-yellow-400 fill-current" />
                        <span className="ml-1 font-bold">{review.rating}</span>
                      </div>
                    </div>
                    
                    {review.review && (
                      <p className="text-gray-700 mb-2">{review.review}</p>
                    )}
                    
                    <p className="text-sm text-gray-500">
                      Stayed: {new Date(review.checkIn).toLocaleDateString()} - {new Date(review.checkOut).toLocaleDateString()}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p className="text-gray-600 text-center py-8">No reviews yet. Be the first to review!</p>
        )}
      </div>
    </div>
  );
}
