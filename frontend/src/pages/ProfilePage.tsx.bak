import { useState, useEffect } from 'react';
import { useParams, Link } from 'react-router-dom';
import {
  User as UserIcon,
  MapPin,
  Link as LinkIcon,
  Calendar,
  Edit,
  Settings,
  Camera,
  Tent,
  Users,
  Award,
  TrendingUp,
  Star,
} from 'lucide-react';
import api from '../services/api';
import { User as UserType } from '../services/auth.service';

interface Profile {
  id: string;
  username: string;
  firstName: string;
  lastName: string;
  profilePicture?: string;
  coverImage?: string;
  bio?: string;
  location?: string;
  website?: string;
  isCreator: boolean;
  creatorBio?: string;
  creatorBadges: string[];
  followerCount: number;
  followingCount: number;
  campingStyle?: string;
  favoriteActivities: string[];
  experienceLevel?: string;
  tripsHosted: number;
  tripsAttended: number;
  mealsCooked: number;
  createdAt: string;
}

interface ProfilePageProps {
  user: UserType;
}

export default function ProfilePage({ user }: ProfilePageProps) {
  const { username } = useParams<{ username: string }>();
  const [profile, setProfile] = useState<Profile | null>(null);
  const [loading, setLoading] = useState(true);
  const [isFollowing, setIsFollowing] = useState(false);
  const [showEditModal, setShowEditModal] = useState(false);
  const [showCreatorModal, setShowCreatorModal] = useState(false);

  const isOwnProfile = user.username === username;

  useEffect(() => {
    if (username) {
      loadProfile();
      if (!isOwnProfile) {
        checkFollowing();
      }
    }
  }, [username]);

  const loadProfile = async () => {
    try {
      setLoading(true);
      const { data } = await api.get(`/profile/${username}`);
      setProfile(data);
    } catch (error) {
      console.error('Load profile error:', error);
    } finally {
      setLoading(false);
    }
  };

  const checkFollowing = async () => {
    try {
      if (!profile) return;
      const { data } = await api.get(`/profile/${profile.id}/is-following`);
      setIsFollowing(data.isFollowing);
    } catch (error) {
      console.error('Check following error:', error);
    }
  };

  const handleFollow = async () => {
    if (!profile) return;
    try {
      if (isFollowing) {
        await api.delete(`/profile/${profile.id}/follow`);
        setIsFollowing(false);
        setProfile({ ...profile, followerCount: profile.followerCount - 1 });
      } else {
        await api.post(`/profile/${profile.id}/follow`);
        setIsFollowing(true);
        setProfile({ ...profile, followerCount: profile.followerCount + 1 });
      }
    } catch (error) {
      console.error('Follow/unfollow error:', error);
      alert('Failed to update follow status');
    }
  };

  const getCampingStyleLabel = (style?: string) => {
    const labels: any = {
      TENT: '⛺ Tent Camping',
      RV: '🚐 RV Camping',
      GLAMPING: '✨ Glamping',
      BACKPACKING: '🎒 Backpacking',
      CAR_CAMPING: '🚗 Car Camping',
    };
    return style ? labels[style] : null;
  };

  const getExperienceLevelLabel = (level?: string) => {
    const labels: any = {
      BEGINNER: '🌱 Beginner',
      INTERMEDIATE: '🔥 Intermediate',
      EXPERT: '⭐ Expert',
    };
    return level ? labels[level] : null;
  };

  if (loading || !profile) {
    return (
      <div className="max-w-6xl mx-auto px-2 sm:px-4 py-8">
        <div className="text-center py-12">
          <div className="text-xl">Loading profile...</div>
        </div>
      </div>
    );
  }

  return (
    <div className="max-w-6xl mx-auto px-2 sm:px-4 py-4 sm:py-8">
      {/* Cover Image */}
      <div className="bg-white rounded-lg shadow-md overflow-hidden mb-4 sm:mb-6">
        <div
          className="h-32 sm:h-48 bg-gradient-to-r from-orange-400 via-red-500 to-pink-500 relative"
          style={
            profile.coverImage
              ? { backgroundImage: `url(${profile.coverImage})`, backgroundSize: 'cover', backgroundPosition: 'center' }
              : {}
          }
        >
          {isOwnProfile && (
            <button className="absolute top-2 right-2 sm:top-4 sm:right-4 bg-white rounded-lg p-2 shadow-md hover:bg-gray-100">
              <Camera className="w-4 h-4 sm:w-5 sm:h-5 text-gray-700" />
            </button>
          )}
        </div>

        {/* Profile Header */}
        <div className="p-4 sm:p-6">
          <div className="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
            {/* Avatar and Info */}
            <div className="flex flex-col sm:flex-row items-center sm:items-start gap-4 flex-1 min-w-0">
              <div className="relative -mt-16 sm:-mt-20">
                {profile.profilePicture ? (
                  <img
                    src={profile.profilePicture}
                    alt={profile.firstName}
                    className="w-24 h-24 sm:w-32 sm:h-32 rounded-full border-4 border-white shadow-lg object-cover"
                  />
                ) : (
                  <div className="w-24 h-24 sm:w-32 sm:h-32 rounded-full border-4 border-white shadow-lg bg-primary-100 flex items-center justify-center">
                    <span className="text-3xl sm:text-4xl font-bold text-primary-600">
                      {profile.firstName[0]}{profile.lastName[0]}
                    </span>
                  </div>
                )}
                {isOwnProfile && (
                  <button className="absolute bottom-0 right-0 bg-white rounded-full p-2 shadow-md hover:bg-gray-100">
                    <Camera className="w-3 h-3 sm:w-4 sm:h-4 text-gray-700" />
                  </button>
                )}
              </div>

              <div className="flex-1 min-w-0 text-center sm:text-left mt-2 sm:mt-0">
                <div className="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 mb-2">
                  <h1 className="text-2xl sm:text-3xl font-bold text-gray-900 break-words">
                    {profile.firstName} {profile.lastName}
                  </h1>
                  {profile.isCreator && (
                    <span className="inline-flex items-center px-2 sm:px-3 py-1 rounded-full text-xs sm:text-sm font-medium bg-gradient-to-r from-purple-500 to-pink-500 text-white mx-auto sm:mx-0">
                      <Star className="w-3 h-3 sm:w-4 sm:h-4 mr-1" />
                      Creator
                    </span>
                  )}
                </div>
                <p className="text-sm sm:text-base text-gray-600 mb-3">@{profile.username}</p>

                {profile.bio && (
                  <p className="text-sm sm:text-base text-gray-700 mb-3 break-words">{profile.bio}</p>
                )}

                {profile.isCreator && profile.creatorBio && (
                  <div className="bg-purple-50 rounded-lg p-3 mb-3">
                    <p className="text-xs sm:text-sm text-purple-900 break-words">{profile.creatorBio}</p>
                  </div>
                )}

                <div className="flex flex-wrap gap-3 sm:gap-4 text-xs sm:text-sm text-gray-600 justify-center sm:justify-start">
                  {profile.location && (
                    <div className="flex items-center">
                      <MapPin className="w-3 h-3 sm:w-4 sm:h-4 mr-1 shrink-0" />
                      <span className="truncate">{profile.location}</span>
                    </div>
                  )}
                  {profile.website && (
                    
                      href={profile.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="flex items-center text-primary-600 hover:text-primary-700"
                   <a>
                      <LinkIcon className="w-3 h-3 sm:w-4 sm:h-4 mr-1 shrink-0" />
                      <span className="truncate">Website</span>
                    </a>
                  )}
                  <div className="flex items-center">
                    <Calendar className="w-3 h-3 sm:w-4 sm:h-4 mr-1 shrink-0" />
                    <span>Joined {new Date(profile.createdAt).toLocaleDateString()}</span>
                  </div>
                </div>

                {/* Creator Badges */}
                {profile.isCreator && profile.creatorBadges.length > 0 && (
                  <div className="flex flex-wrap gap-2 mt-3">
                    {profile.creatorBadges.map((badge, idx) => (
                      <span
                        key={idx}
                        className="inline-flex items-center px-2 sm:px-3 py-1 rounded-full text-xs bg-yellow-100 text-yellow-800"
                      >
                        <Award className="w-3 h-3 mr-1" />
                        {badge}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>

            {/* Action Buttons */}
            <div className="flex flex-col sm:flex-row gap-2 shrink-0 w-full sm:w-auto">
              {isOwnProfile ? (
                <>
                  <button
                    onClick={() => setShowEditModal(true)}
                    className="btn btn-primary flex items-center justify-center space-x-2 text-sm sm:text-base"
                  >
                    <Edit className="w-4 h-4" />
                    <span>Edit Profile</span>
                  </button>
                  {!profile.isCreator && (
                    <button
                      onClick={() => setShowCreatorModal(true)}
                      className="btn btn-secondary flex items-center justify-center space-x-2 text-sm sm:text-base"
                    >
                      <Star className="w-4 h-4" />
                      <span>Enable Creator Mode</span>
                    </button>
                  )}
                  <Link to="/settings" className="btn btn-secondary flex items-center justify-center space-x-2 text-sm sm:text-base">
                    <Settings className="w-4 h-4" />
                    <span>Settings</span>
                  </Link>
                </>
              ) : (
                <button
                  onClick={handleFollow}
                  className={`btn flex items-center justify-center space-x-2 text-sm sm:text-base ${
                    isFollowing ? 'btn-secondary' : 'btn-primary'
                  }`}
                >
                  <Users className="w-4 h-4" />
                  <span>{isFollowing ? 'Following' : 'Follow'}</span>
                </button>
              )}
            </div>
          </div>

          {/* Stats */}
          <div className="grid grid-cols-2 sm:grid-cols-5 gap-3 sm:gap-4 mt-6 pt-6 border-t border-gray-200">
            <Link
              to={`/profile/${username}/followers`}
              className="text-center hover:bg-gray-50 rounded-lg p-2 transition"
            >
              <div className="text-xl sm:text-2xl font-bold text-gray-900">{profile.followerCount}</div>
              <div className="text-xs sm:text-sm text-gray-600">Followers</div>
            </Link>
            <Link
              to={`/profile/${username}/following`}
              className="text-center hover:bg-gray-50 rounded-lg p-2 transition"
            >
              <div className="text-xl sm:text-2xl font-bold text-gray-900">{profile.followingCount}</div>
              <div className="text-xs sm:text-sm text-gray-600">Following</div>
            </Link>
            <div className="text-center p-2">
              <div className="text-xl sm:text-2xl font-bold text-gray-900">{profile.tripsHosted}</div>
              <div className="text-xs sm:text-sm text-gray-600">Trips Hosted</div>
            </div>
            <div className="text-center p-2">
              <div className="text-xl sm:text-2xl font-bold text-gray-900">{profile.tripsAttended}</div>
              <div className="text-xs sm:text-sm text-gray-600">Trips Attended</div>
            </div>
            <div className="text-center p-2">
              <div className="text-xl sm:text-2xl font-bold text-gray-900">{profile.mealsCooked}</div>
              <div className="text-xs sm:text-sm text-gray-600">Meals Cooked</div>
            </div>
          </div>
        </div>
      </div>

      {/* Camping Info */}
      {(profile.campingStyle || profile.favoriteActivities.length > 0 || profile.experienceLevel) && (
        <div className="bg-white rounded-lg shadow-md p-4 sm:p-6 mb-4 sm:mb-6">
          <h2 className="text-lg sm:text-xl font-bold text-gray-900 mb-4 flex items-center">
            <Tent className="w-5 h-5 sm:w-6 sm:h-6 mr-2 text-primary-600" />
            Camping Preferences
          </h2>

          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
            {profile.campingStyle && (
              <div className="bg-gray-50 rounded-lg p-3 sm:p-4">
                <div className="text-xs sm:text-sm text-gray-600 mb-1">Camping Style</div>
                <div className="text-sm sm:text-base font-semibold text-gray-900">
                  {getCampingStyleLabel(profile.campingStyle)}
                </div>
              </div>
            )}

            {profile.experienceLevel && (
              <div className="bg-gray-50 rounded-lg p-3 sm:p-4">
                <div className="text-xs sm:text-sm text-gray-600 mb-1">Experience Level</div>
                <div className="text-sm sm:text-base font-semibold text-gray-900">
                  {getExperienceLevelLabel(profile.experienceLevel)}
                </div>
              </div>
            )}

            {profile.favoriteActivities.length > 0 && (
              <div className="bg-gray-50 rounded-lg p-3 sm:p-4 sm:col-span-2 lg:col-span-1">
                <div className="text-xs sm:text-sm text-gray-600 mb-2">Favorite Activities</div>
                <div className="flex flex-wrap gap-1.5 sm:gap-2">
                  {profile.favoriteActivities.map((activity, idx) => (
                    <span
                      key={idx}
                      className="px-2 sm:px-3 py-1 bg-white rounded-full text-xs sm:text-sm text-gray-700 border border-gray-200"
                    >
                      {activity}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {/* Content Sections - Placeholder for future videos/blogs */}
      {profile.isCreator && (
        <div className="bg-white rounded-lg shadow-md p-4 sm:p-6">
          <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
            <h2 className="text-lg sm:text-xl font-bold text-gray-900">Content</h2>
            {isOwnProfile && (
              <div className="flex flex-col sm:flex-row gap-2">
                <button className="btn btn-primary text-sm flex items-center justify-center">
                  <TrendingUp className="w-4 h-4 mr-2" />
                  Upload Video
                </button>
                <button className="btn btn-secondary text-sm flex items-center justify-center">
                  <Edit className="w-4 h-4 mr-2" />
                  Write Post
                </button>
              </div>
            )}
          </div>

          <div className="text-center py-12 text-gray-600">
            <p className="text-sm sm:text-base">No content yet. Stay tuned!</p>
          </div>
        </div>
      )}
    </div>
  );
}
